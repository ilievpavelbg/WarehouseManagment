@model FinishedGoodsStockDetailsModel

@{
    ViewData["Title"] = "Детайли готова продукция";
}

<div class="app-page-header">
    <div>
        <h1>@Model.ProductSku - @Model.ProductName</h1>
        <p>Разбивка на текущата продаваема наличност по размер / вариант.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="FinishedGoodsStock" asp-action="Index">Назад</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="app-stat-card">
            <span>Обща наличност</span>
            <strong>@QuantityDisplayFormatter.Format(Model.Quantity, Model.UnitOfMeasureName, true)</strong>
        </div>
    </div>
    <div class="col-md-3">
        <div class="app-stat-card">
            <span>Варианти</span>
            <strong>@Model.VariantCount</strong>
        </div>
    </div>
    <div class="col-md-3">
        <div class="app-stat-card">
            <span>Последно приемане</span>
            <strong>@(Model.LastReceiptOn.HasValue ? Model.LastReceiptOn.Value.ToString("dd.MM.yyyy HH:mm") : "-")</strong>
        </div>
    </div>
    <div class="col-md-3">
        <div class="app-stat-card">
            <span>Последен FGR</span>
            <strong>
                @if (string.IsNullOrWhiteSpace(Model.LastFgrDocumentNumber))
                {
                    <span>-</span>
                }
                else
                {
                    <a asp-controller="ProductionDocuments" asp-action="ViewDocument" asp-route-documentNumber="@Model.LastFgrDocumentNumber">@Model.LastFgrDocumentNumber</a>
                }
            </strong>
        </div>
    </div>
</div>

<div class="app-card mb-3">
    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
        <h5 class="mb-0">Варианти / размери</h5>
        <div class="text-muted">Склад: @Model.FinishedGoodsWarehouseName</div>
    </div>

    @if (!Model.Variants.Any())
    {
        <div class="alert alert-info mb-0">Няма създадени варианти за този артикул.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table app-table align-middle">
                <thead>
                    <tr>
                        <th>Размер / вариант</th>
                        <th class="text-end">Наличност</th>
                        <th>Баркод</th>
                        <th>Последно приемане</th>
                        <th>Последен FGR</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var variant in Model.Variants)
                    {
                        <tr>
                            <td class="fw-semibold">@variant.Size</td>
                            <td class="text-end">@QuantityDisplayFormatter.Format(variant.Quantity, Model.UnitOfMeasureName, true)</td>
                            <td>@(string.IsNullOrWhiteSpace(variant.BarcodeValue) ? "-" : variant.BarcodeValue)</td>
                            <td>@(variant.LastReceiptOn.HasValue ? variant.LastReceiptOn.Value.ToString("dd.MM.yyyy HH:mm") : "-")</td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(variant.LastFgrDocumentNumber))
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <a asp-controller="ProductionDocuments" asp-action="ViewDocument" asp-route-documentNumber="@variant.LastFgrDocumentNumber">@variant.LastFgrDocumentNumber</a>
                                }
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Label" asp-action="Index" asp-route-ProductInventoryId="@variant.ProductInventoryId" asp-route-Quantity="1">Печат етикет</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="app-card">
    <h5>Последни FGR приемания</h5>
    @if (!Model.RecentReceipts.Any())
    {
        <div class="alert alert-info mb-0">Няма FGR приемания за този артикул.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table app-table align-middle">
                <thead>
                    <tr>
                        <th>FGR документ</th>
                        <th>Размер</th>
                        <th class="text-end">Количество</th>
                        <th>Дата</th>
                        <th>Производствена поръчка</th>
                        <th>Склад</th>
                        <th>Потребител</th>
                        <th>Етикети</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var receipt in Model.RecentReceipts)
                    {
                        <tr>
                            <td><a asp-controller="ProductionDocuments" asp-action="ViewDocument" asp-route-documentNumber="@receipt.DocumentNumber">@receipt.DocumentNumber</a></td>
                            <td>@receipt.Size</td>
                            <td class="text-end">@QuantityDisplayFormatter.Format(receipt.Quantity, Model.UnitOfMeasureName, true)</td>
                            <td>@receipt.CreatedOn.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@receipt.ProductionOrderNumber</td>
                            <td>@receipt.WarehouseName</td>
                            <td>@receipt.UserName</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Label" asp-action="Index" asp-route-ProductInventoryId="@receipt.ProductInventoryId" asp-route-Quantity="@receipt.Quantity">Печат</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
