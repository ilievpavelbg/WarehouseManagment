@model ReportsIndexModel<BarcodeReportRowModel>
@{ ViewData["Title"] = "Баркод справка"; }
<div class="app-page-header"><div><h1>Баркод справка</h1><p>Метаданни за POS баркодове и печат на етикети.</p></div><a class="btn btn-outline-success" asp-action="Export" asp-route-report="barcodes">Excel</a></div>
<form method="get" class="app-filter-panel row g-2 align-items-end"><div class="col-md-4"><label class="form-label">Търсене</label><input name="Search" value="@Model.Filter.Search" class="form-control" /></div><div class="col-md-2 form-check mt-4"><input type="checkbox" name="MissingMetadataOnly" value="true" checked="@Model.Filter.MissingMetadataOnly" class="form-check-input" /><label class="form-check-label">Липсва metadata</label></div><div class="col-md-2 form-check mt-4"><input type="checkbox" name="NeverPrintedOnly" value="true" checked="@Model.Filter.NeverPrintedOnly" class="form-check-input" /><label class="form-check-label">Непечатани</label></div><div class="col-md-2"><button class="btn btn-primary w-100">Филтър</button></div></form>
<div class="app-card"><table class="table app-table"><thead><tr><th>SKU</th><th>Артикул</th><th>Вариант</th><th>Баркод</th><th>Тип</th><th>Генериран</th><th>От</th><th>Последен печат</th><th class="text-end">Брой</th><th class="text-end">Наличност</th></tr></thead><tbody>
@foreach (var row in Model.Rows){<tr><td>@row.SKU</td><td>@row.Product</td><td>@row.Variant</td><td><code>@row.BarcodeValue</code></td><td>@row.BarcodeType</td><td>@row.GeneratedOn?.ToString("dd.MM.yyyy HH:mm")</td><td>@row.GeneratedBy</td><td>@row.LastPrintedOn?.ToString("dd.MM.yyyy HH:mm")</td><td class="text-end">@row.PrintCount</td><td class="text-end">@row.CurrentStock бр.</td></tr>}
</tbody></table></div>
