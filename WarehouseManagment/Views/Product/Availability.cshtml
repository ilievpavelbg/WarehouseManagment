@using WarehouseManagment.Constants
@using WarehouseManagment.Extensions;
@model ProductModel

@{
    ViewData["Title"] = $"Наличност на артикул #{Model.SKU}";
    var canGenerateBarcodes = User.IsInRole(ApplicationRoles.Administrator) || User.IsInRole(ApplicationRoles.SalesManager);
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
<div class="alert alert-danger" id="errorMessage" style="display:none"></div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-danger" asp-action="Create" asp-controller="ProductInventory" asp-route-Id="@Model.Id">Добави размер</a>
    @if (canGenerateBarcodes)
    {
        <form asp-controller="ProductInventory" asp-action="GenerateMissingBarcodes" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnProductId" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-primary">Генерирай липсващи баркодове</button>
        </form>
        <form asp-controller="ProductInventory" asp-action="FillMissingBarcodeMetadata" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnProductId" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-secondary">Попълни липсващи метаданни</button>
        </form>
    }
</div>

<div class="row">
    <div class="col-12">
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr class="text-center">
                        <th scope="col">Размер</th>
                        <th scope="col">Количество</th>
                        <th scope="col">Баркод</th>
                        <th scope="col">Метаданни</th>
                        <th scope="col">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var productInventory in Model.ProductInventoriesModel)
                    {
                        <tr class="text-center">
                            <td><span class="prodSize" data-size="@productInventory.Size">@productInventory.Size</span></td>
                            <td>
                                <span class="display-span">
                                    <span style="display:block" class="ProdInv">@productInventory.Quantity бр.</span>
                                    <input style="display:none" type="number" min="0" value="@productInventory.Quantity" class="form-control form-control-sm text-center">
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(productInventory.BarcodeValue))
                                {
                                    <div><code>@productInventory.BarcodeValue</code></div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary copy-barcode mt-1" data-barcode="@productInventory.BarcodeValue">Копирай</button>
                                    <a class="btn btn-sm btn-outline-primary mt-1" asp-controller="Label" asp-action="Index" asp-route-ProductInventoryId="@productInventory.Id" asp-route-Quantity="1">Печат етикет</a>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Липсва</span>
                                }
                            </td>
                            <td class="small text-start">
                                @if (!string.IsNullOrWhiteSpace(productInventory.BarcodeValue))
                                {
                                    <div><strong>Тип:</strong> @(productInventory.BarcodeType ?? "-")</div>
                                    <div><strong>Генериран:</strong> @(productInventory.BarcodeGeneratedOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                                    <div><strong>Потребител:</strong> @(productInventory.BarcodeGeneratedByUserNameSnapshot ?? "-")</div>
                                    <div><strong>Последен печат:</strong> @(productInventory.BarcodePrintedOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                                    <div><strong>Отпечатани етикети:</strong> @productInventory.BarcodePrintCount</div>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td style="width:263px;" data-product-id="@productInventory.ProductId" data-product-sku="@productInventory.ProductSKU">
                                <a class="btn btn-sm btn-primary ChangeQty" style="display: block">Промени количество</a>
                                <a class="btn btn-sm btn-success SaveQty" style="display: none" data-id="@productInventory.Id" data-confirm="Сигурни ли сте, че искате да запазите това количество?">Запази промените</a>
                                <a class="btn btn-sm btn-danger mt-2 CancelChange" style="display: none">Отмени промените</a>
                            </td>
                        </tr>
                    }
                    <tr style="background-color:#C0C0C0">
                        <td colspan="1" class="h4 text-center">
                            Тотал:
                        </td>
                        <td class="h4 text-center">
                            @Model.ProductInventoriesModel.Sum(x => x.Quantity) бр.
                        </td>
                        <td colspan="3"></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="col-3 mt-4">
            <a class="btn btn-primary" href="/Product/All">Назад</a>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('.copy-barcode').on('click', function () {
                var barcode = $(this).data('barcode');
                navigator.clipboard.writeText(barcode);
            });

            $('.ChangeQty').on('click', function (e) {
                e.preventDefault();

                var row = $(this).closest('tr');
                var displaySpan = row.find('.display-span');
                displaySpan.find('.ProdInv').css("display", "none");
                displaySpan.find('input').css("display", "block");
                row.find('.SaveQty').css("display", "block");
                row.find('.CancelChange').css("display", "block");
                row.find('.ChangeQty').css("display", "none");
            })

            $('.CancelChange').on('click', function (e) {
                e.preventDefault();

                var row = $(this).closest('tr');
                var displaySpan = row.find('.display-span');
                displaySpan.find('.ProdInv').css("display", "block");
                displaySpan.find('input').css("display", "none");
                row.find('.ChangeQty').css("display", "block");
                row.find('.SaveQty').css("display", "none");
                row.find('.CancelChange').css("display", "none");
            })

            $('.SaveQty').on('click', function (e) {
                e.preventDefault();

                var productId = $(this).closest('td').data('product-id');
                var productSKU = $(this).closest('td').data('product-sku');

                var id = $(this).data('id');
                var row = $(this).closest('tr');
                var displaySpan = row.find('.display-span');
                var quantity = displaySpan.find('input').val();
                var size = row.find('.prodSize').data('size');

                var model = {
                    Id: id,
                    Quantity: quantity,
                    Size: size,
                    ProductId: productId,
                    ProductSKU: productSKU
                }

                var confirmMessage = $(this).data('confirm');

                if (confirm(confirmMessage)) {
                    $.ajax({
                        type: "POST",
                        url: "/ProductInventory/Edit",
                        data: model,
                        success: function (response) {
                            if (response.response === true) {
                                location.reload();
                            } else {
                                if (response.message) {
                                    $('#errorMessage').text("Възникна грешка при промяна на количеството: " + response.message);
                                }
                                $('#errorMessage').show();
                                setTimeout(function () {
                                    $('#errorMessage').hide();
                                }, 3000);
                            }
                        }
                    });
                }

                displaySpan.find('.ProdInv').css("display", "block");
                displaySpan.find('input').css("display", "none");
                row.find('.ChangeQty').css("display", "block");
                row.find('.SaveQty').css("display", "none");
                row.find('.CancelChange').css("display", "none");
            })
        })
    </script>
}
