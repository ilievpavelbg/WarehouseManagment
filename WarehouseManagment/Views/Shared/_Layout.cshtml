<!DOCTYPE html>
<html lang="bg">
@inject IWebHostEnvironment WebHostEnvironment
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VETEIDA ERP</title>
    @if (!WebHostEnvironment.IsDevelopment())
    {
        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WarehouseManagment.styles.css" asp-append-version="true" />
</head>
<body class="app-shell">
    @Html.AntiForgeryToken()
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
        var isAdministrator = User.IsInRole(ApplicationRoles.Administrator);
        var isWarehouseManager = User.IsInRole(ApplicationRoles.WarehouseManager);
        var isWarehouseOperator = User.IsInRole(ApplicationRoles.WarehouseOperator);
        var isReadOnly = User.IsInRole(ApplicationRoles.ReadOnly);
        var isProductionManager = User.IsInRole(ApplicationRoles.ProductionManager);
        var isSalesManager = User.IsInRole(ApplicationRoles.SalesManager);
        var isSalesOperator = User.IsInRole(ApplicationRoles.SalesOperator);
        var isProductionWorker = User.IsInRole(ApplicationRoles.Cutter) || User.IsInRole(ApplicationRoles.Sewer) || User.IsInRole(ApplicationRoles.Finisher);
        var canManageWarehouse = isAdministrator || isWarehouseManager;
        var canReadWarehouse = canManageWarehouse || isWarehouseOperator || isReadOnly;
        var canViewLowStock = canManageWarehouse || isReadOnly;
        var canManageProduction = isAdministrator || isProductionManager;
        var canWorkProduction = canManageProduction || isProductionWorker;
        var canAccessSales = isAdministrator || isSalesManager || isSalesOperator;
        var canViewReports = isAdministrator || isWarehouseManager || isProductionManager || isSalesManager;
        var isProductionWorkerOnly = isProductionWorker && !canManageProduction;
        var brandController = isProductionWorkerOnly ? "ProductionWork" : "Home";
        var currentRole = isAdministrator ? "Administrator" :
            isSalesManager ? "SalesManager" :
            isWarehouseManager ? "WarehouseManager" :
            isProductionManager ? "ProductionManager" :
            isSalesOperator ? "SalesOperator" :
            isWarehouseOperator ? "WarehouseOperator" :
            isProductionWorker ? "Production" :
            isReadOnly ? "ReadOnly" : string.Empty;
        string Active(string controller, string? action = null) =>
            string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
            (action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
                ? "active"
                : string.Empty;
        string GroupOpen(params string[] controllers) => controllers.Contains(currentController, StringComparer.OrdinalIgnoreCase) ? "show" : string.Empty;
    }

    <div class="app-layout" id="appLayout">
        <aside class="app-sidebar" id="appSidebar">
            <div class="app-brand">
                <a asp-controller="@brandController" asp-action="Index">VETEIDA ERP</a>
                <button class="btn btn-sm btn-outline-light app-sidebar-toggle" type="button" id="sidebarToggle">☰</button>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <nav class="app-nav">
                    @if (isProductionWorkerOnly)
                    {
                        <a class="app-nav-link @Active("ProductionWork")" asp-controller="ProductionWork" asp-action="Index"><span>МЗ</span><em>Моите задачи</em></a>
                    }
                    else
                    {
                        <a class="app-nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><span>Н</span><em>Начало</em></a>

                        @if (canReadWarehouse)
                        {
                            <button class="app-nav-group" type="button" data-bs-toggle="collapse" data-bs-target="#wmsMenu" aria-expanded="true">Склад</button>
                            <div class="collapse @GroupOpen("Warehouse", "WarehouseSettings", "Material", "StockInquiry", "FinishedGoodsStock", "LowStock", "InventoryMovement", "MaterialStockCard")" id="wmsMenu">
                                <a class="@Active("Home")" asp-controller="Home" asp-action="Index">WMS табло</a>
                                <a asp-controller="Material" asp-action="Index">Материали</a>
                                <a class="@Active("StockInquiry")" asp-controller="StockInquiry" asp-action="Index">Наличности</a>
                                <a class="@Active("FinishedGoodsStock")" asp-controller="FinishedGoodsStock" asp-action="Index">Готова продукция</a>
                                <a class="@Active("InventoryMovement")" asp-controller="InventoryMovement" asp-action="Index">Движения</a>
                                @if (canViewLowStock)
                                {
                                    <a class="@Active("LowStock")" asp-controller="LowStock" asp-action="Index">Под минимум</a>
                                }
                                @if (canManageWarehouse)
                                {
                                    <a class="@Active("Warehouse")" asp-controller="Warehouse" asp-action="Index">Складове</a>
                                    <a class="@Active("WarehouseSettings")" asp-controller="WarehouseSettings" asp-action="Index">Настройки складове</a>
                                }
                            </div>
                        }

                        @if (canWorkProduction)
                        {
                            <button class="app-nav-group" type="button" data-bs-toggle="collapse" data-bs-target="#productionMenu">Производство</button>
                            <div class="collapse @GroupOpen("ProductionOrder", "ProductionWork", "ProductionProfile", "CostComponent", "ProductCostCalculation", "BillOfMaterials", "ProductionOperation", "ProductRouting")" id="productionMenu">
                                <a class="@Active("ProductionWork")" asp-controller="ProductionWork" asp-action="Index">Моите задачи</a>
                                @if (canManageProduction)
                                {
                                    <a class="@Active("ProductionOrder")" asp-controller="ProductionOrder" asp-action="Index">Производствени поръчки</a>
                                    <a class="@Active("BillOfMaterials")" asp-controller="BillOfMaterials" asp-action="Index">Разходни норми</a>
                                    <a class="@Active("ProductRouting")" asp-controller="ProductRouting" asp-action="Index">Маршрути</a>
                                    <a class="@Active("ProductionProfile")" asp-controller="ProductionProfile" asp-action="Index">Профили</a>
                                }
                            </div>
                        }

                        @if (canAccessSales)
                        {
                            <button class="app-nav-group" type="button" data-bs-toggle="collapse" data-bs-target="#salesMenu">Продажби</button>
                            <div class="collapse @GroupOpen("Product", "Sale", "Courier", "Pos", "Label")" id="salesMenu">
                                <a class="@Active("Pos", "Index")" asp-controller="Pos" asp-action="Index">POS</a>
                                <a class="@Active("Pos", "Sales")" asp-controller="Pos" asp-action="Sales">POS продажби</a>
                                <a class="@Active("Product")" asp-controller="Product" asp-action="Index">Артикули</a>
                                <a class="@Active("Label")" asp-controller="Label" asp-action="Index">Печат на етикети</a>
                                @if (isSalesManager || isAdministrator)
                                {
                                    <a asp-controller="Sale" asp-action="AllSales">Стари продажби</a>
                                    <a asp-controller="Courier" asp-action="AllCouriers">Куриер / доставки</a>
                                }
                            </div>
                        }

                        @if (canViewReports)
                        {
                            <button class="app-nav-group" type="button" data-bs-toggle="collapse" data-bs-target="#reportsMenu">Справки</button>
                            <div class="collapse @GroupOpen("Reports")" id="reportsMenu">
                                <a class="@Active("Reports", "Dashboard")" asp-controller="Reports" asp-action="Dashboard">Управленско табло</a>
                                @if (isSalesManager || isAdministrator)
                                {
                                    <a class="@Active("Reports", "Sales")" asp-controller="Reports" asp-action="Sales">Продажби</a>
                                }
                                @if (canManageWarehouse)
                                {
                                    <a class="@Active("Reports", "Warehouse")" asp-controller="Reports" asp-action="Warehouse">Склад</a>
                                }
                                @if (canManageProduction)
                                {
                                    <a class="@Active("Reports", "Production")" asp-controller="Reports" asp-action="Production">Производство</a>
                                }
                                <a class="@Active("Reports", "Barcodes")" asp-controller="Reports" asp-action="Barcodes">Артикули / баркод</a>
                                <a class="@Active("Reports", "Traceability")" asp-controller="Reports" asp-action="Traceability">Проследимост</a>
                            </div>
                        }

                        @if (isAdministrator)
                        {
                            <button class="app-nav-group" type="button" data-bs-toggle="collapse" data-bs-target="#adminMenu">Администрация</button>
                            <div class="collapse @GroupOpen("UserRoles", "AuditLog", "MaterialCategory", "UnitOfMeasure", "Supplier")" id="adminMenu">
                                <a class="@Active("UserRoles")" asp-controller="UserRoles" asp-action="Index">Потребители и роли</a>
                                <a class="@Active("AuditLog")" asp-controller="AuditLog" asp-action="Index">Audit Log</a>
                                <a asp-controller="MaterialCategory" asp-action="Index">Категории</a>
                                <a asp-controller="UnitOfMeasure" asp-action="Index">Мерни единици</a>
                                <a asp-controller="Supplier" asp-action="Index">Доставчици</a>
                            </div>
                        }
                    }
                </nav>
            }
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button class="btn btn-outline-secondary d-lg-none" type="button" id="mobileSidebarToggle">☰</button>
                <div>
                    <div class="app-top-title">@ViewData["Title"]</div>
                    <div class="app-breadcrumb">@currentController / @currentAction</div>
                </div>
                <div class="ms-auto d-flex align-items-center gap-3">
                    @if (!string.IsNullOrWhiteSpace(currentRole))
                    {
                        <span class="badge bg-light text-dark border">@currentRole</span>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </header>

            <main role="main" class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>

    @if (!WebHostEnvironment.IsDevelopment())
    {
        <script src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit" async defer></script>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        $.ajaxSetup({
            beforeSend: function (xhr, settings) {
                var token = $('input[name="__RequestVerificationToken"]').first().val();
                var method = settings.type || settings.method || 'GET';

                if (token && !/^(GET|HEAD|OPTIONS|TRACE)$/i.test(method)) {
                    xhr.setRequestHeader('RequestVerificationToken', token);
                }
            }
        });

        (function () {
            const layout = document.getElementById('appLayout');
            const collapsed = localStorage.getItem('veteida-sidebar-collapsed') === 'true';
            if (collapsed) layout?.classList.add('sidebar-collapsed');

            document.getElementById('sidebarToggle')?.addEventListener('click', function () {
                layout?.classList.toggle('sidebar-collapsed');
                localStorage.setItem('veteida-sidebar-collapsed', layout?.classList.contains('sidebar-collapsed') ? 'true' : 'false');
            });

            document.getElementById('mobileSidebarToggle')?.addEventListener('click', function () {
                layout?.classList.toggle('sidebar-mobile-open');
            });
        })();
    </script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
