@model ProductionOrderDetailsModel

@{
    ViewData["Title"] = "Производствена поръчка";
    var materialReadiness = Model.MaterialReadiness;
    var canStart = Model.Status == ProductionOrderStatus.Released && materialReadiness?.IsReady == true && materialReadiness.IsTransferred == false;
    var isReleasedWaitingForMaterials = Model.Status == ProductionOrderStatus.Released && materialReadiness != null && !materialReadiness.IsReady;
    var isAwaitingFinalization = Model.Status == ProductionOrderStatus.ProductionCompleted;
    var shortageCount = materialReadiness?.Rows.Count(x => x.ShortageQuantity > 0) ?? 0;
    var readinessText = materialReadiness == null
        ? "Няма данни за материална готовност"
        : materialReadiness.IsTransferred
            ? "Материалите са прехвърлени"
            : materialReadiness.IsReady
                ? "Готова за стартиране"
                : "Не е готова за стартиране";
    var readinessBadgeClass = materialReadiness == null
        ? "bg-secondary"
        : materialReadiness.IsReady || materialReadiness.IsTransferred
            ? "bg-success"
            : "bg-danger";

    var events = new List<(DateTime Date, string Text)>();
    events.Add((Model.CreatedOn, "Поръчката е създадена"));
    if (materialReadiness?.TransferredOn != null)
    {
        events.Add((materialReadiness.TransferredOn.Value, "Материалите са прехвърлени към НЗП"));
    }
    if (Model.ActualStartDate != null)
    {
        events.Add((Model.ActualStartDate.Value, "Производството е стартирано"));
    }
    foreach (var operation in Model.Operations)
    {
        foreach (var entry in operation.WorkHistory)
        {
            events.Add((entry.CreatedOn, $"{operation.OperationName}: отчетена работа"));
        }
    }
    if (Model.Status == ProductionOrderStatus.ProductionCompleted)
    {
        var lastWork = Model.Operations.SelectMany(x => x.WorkHistory).OrderByDescending(x => x.CreatedOn).FirstOrDefault();
        if (lastWork != null)
        {
            events.Add((lastWork.CreatedOn, "Производството е отчетено и очаква финално приключване"));
        }
    }
    if (Model.ProductionFinalizedOn != null)
    {
        events.Add((Model.ProductionFinalizedOn.Value, "Производството е финално приключено"));
    }
    if (Model.CancelledOn != null)
    {
        events.Add((Model.CancelledOn.Value, "Поръчката е отменена"));
    }

    string StepCss(int index)
    {
        if (Model.Status == ProductionOrderStatus.Cancelled)
        {
            return "production-step production-step-cancelled";
        }

        var current = Model.Status switch
        {
            ProductionOrderStatus.Planned => 0,
            ProductionOrderStatus.Released when materialReadiness?.IsTransferred == true => 3,
            ProductionOrderStatus.Released => 2,
            ProductionOrderStatus.InProgress => 4,
            ProductionOrderStatus.ProductionCompleted => 5,
            ProductionOrderStatus.Completed => 6,
            _ => 0
        };

        if (index < current || Model.Status == ProductionOrderStatus.Completed)
        {
            return "production-step production-step-complete";
        }

        return index == current ? "production-step production-step-current" : "production-step";
    }

    string StepMarker(int index)
    {
        if (Model.Status == ProductionOrderStatus.Cancelled)
        {
            return "✕";
        }

        var current = Model.Status switch
        {
            ProductionOrderStatus.Planned => 0,
            ProductionOrderStatus.Released when materialReadiness?.IsTransferred == true => 3,
            ProductionOrderStatus.Released => 2,
            ProductionOrderStatus.InProgress => 4,
            ProductionOrderStatus.ProductionCompleted => 5,
            ProductionOrderStatus.Completed => 6,
            _ => 0
        };

        return index < current || Model.Status == ProductionOrderStatus.Completed ? "✓" : index == current ? "●" : "○";
    }
}

<h1 class="text-center">@Model.OrderNumber</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (isReleasedWaitingForMaterials)
{
    <div class="alert alert-warning border-warning shadow-sm">
        <h5 class="alert-heading mb-2">Поръчката изчаква материали</h5>
        <p class="mb-0">
            Поръчката е освободена, но не може да бъде стартирана поради недостиг на материали.
            Производството ще може да започне след осигуряване на всички необходими материали.
        </p>
    </div>
}

@if (isAwaitingFinalization)
{
    <div class="alert alert-warning border-warning shadow-sm">
        <h5 class="alert-heading mb-2">Производството е отчетено</h5>
        <p class="mb-0">
            Всички производствени операции са приключени. Мениджър трябва да извърши финално приключване,
            за да се отпишат материалите от НЗП и да се приеме готовата продукция в склада.
        </p>
    </div>
}

<div class="card mb-3">
    <div class="card-header">📈 Прогрес</div>
    <div class="card-body">
        <div class="progress production-progress">
            <div class="progress-bar @ProductionOrderDisplayHelper.StatusCss(Model.Status)" role="progressbar" style="width: @Model.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%;" aria-valuenow="@Model.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100">
                @Model.ProgressPercent.ToString("N0")%
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">🏭 Производствен процес</div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            <span class="@StepCss(0)">@StepMarker(0) Планирана</span>
            <span class="@StepCss(1)">@StepMarker(1) Освободена</span>
            <span class="@StepCss(2)">@StepMarker(2) Проверка на материалите</span>
            <span class="@StepCss(3)">@StepMarker(3) Трансфер към НЗП</span>
            <span class="@StepCss(4)">@StepMarker(4) Производство</span>
            <span class="@StepCss(5)">@StepMarker(5) Очаква приключване</span>
            <span class="@StepCss(6)">@StepMarker(6) Завършена</span>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Основна информация</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Поръчка</dt><dd class="col-sm-7">@Model.OrderNumber</dd>
                    <dt class="col-sm-5">Артикул</dt><dd class="col-sm-7">@Model.ProductDisplayName</dd>
                    <dt class="col-sm-5">Размер / вариант</dt><dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.ProductVariant) ? "-" : Model.ProductVariant)</dd>
                    <dt class="col-sm-5">Производствено име</dt><dd class="col-sm-7">@Model.ProductionName</dd>
                    <dt class="col-sm-5">Планирано количество</dt><dd class="col-sm-7">@Model.PlannedQuantity.ToString("N4") @Model.UnitOfMeasure</dd>
                    <dt class="col-sm-5">Приоритет</dt><dd class="col-sm-7">@ProductionOrderDisplayHelper.PriorityText(Model.Priority)</dd>
                    <dt class="col-sm-5">Статус</dt><dd class="col-sm-7"><span class="badge @ProductionOrderDisplayHelper.StatusCss(Model.Status)">@ProductionOrderDisplayHelper.StatusText(Model.Status)</span></dd>
                    <dt class="col-sm-5">Бележки</dt><dd class="col-sm-7">@(Model.Notes ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Използвани версии</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Разходна норма</dt><dd class="col-sm-7">Версия @Model.BillOfMaterialsVersion</dd>
                    <dt class="col-sm-5">Технологичен маршрут</dt><dd class="col-sm-7">Версия @Model.ProductRoutingVersion</dd>
                    <dt class="col-sm-5">Калкулация</dt><dd class="col-sm-7">@Model.CostCalculationText</dd>
                    <dt class="col-sm-5">Склад производство / НЗП</dt><dd class="col-sm-7">@Model.WipWarehouse</dd>
                    <dt class="col-sm-5">Склад готова продукция</dt><dd class="col-sm-7">@Model.FinishedGoodsWarehouse</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">🕒 Събития</div>
    <div class="card-body">
        @if (!events.Any())
        {
            <div class="alert alert-info mb-0">Няма записани събития за тази производствена поръчка.</div>
        }
        else
        {
            <div class="production-timeline">
                @foreach (var item in events.OrderBy(x => x.Date))
                {
                    <div class="production-timeline-item">
                        <div class="fw-bold">@item.Date.ToString("dd.MM.yyyy HH:mm")</div>
                        <div>@item.Text</div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>📦 Материали за производство</span>
        <span class="badge @readinessBadgeClass">@readinessText</span>
    </div>
    <div class="card-body">
        @if (materialReadiness == null)
        {
            <div class="alert alert-info mb-0">Няма информация за материална готовност по тази производствена поръчка.</div>
        }
        else
        {
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Източник:</strong> @(materialReadiness.SourceWarehouse ?? "Основен склад за материали не е зададен")
                </div>
                <div class="col-md-6">
                    <strong>Дестинация:</strong> @(materialReadiness.DestinationWarehouse ?? "Склад производство / НЗП не е зададен")
                </div>
            </div>

            @if (materialReadiness.Rows.Any())
            {
                if (shortageCount > 0)
                {
                    <div class="alert alert-danger">
                        <strong>Липсват @shortageCount материала.</strong><br />
                        Производството не може да бъде стартирано.
                    </div>
                }
                else if (!materialReadiness.IsTransferred)
                {
                    <div class="alert alert-success">
                        <strong>Всички материали са налични.</strong><br />
                        Производството може да бъде стартирано.
                    </div>
                }
            }

            <div class="alert @(materialReadiness.IsReady ? "alert-success" : "alert-warning")">@materialReadiness.Message</div>

            @if (materialReadiness.IsTransferred)
            {
                <dl class="row">
                    <dt class="col-sm-3">PMT документ</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrWhiteSpace(materialReadiness.TransferDocumentNumber))
                        {
                            <a asp-controller="ProductionDocuments" asp-action="ViewDocument" asp-route-documentNumber="@materialReadiness.TransferDocumentNumber">@materialReadiness.TransferDocumentNumber</a>
                            <a class="btn btn-sm btn-outline-info ms-2" asp-controller="AuditLog" asp-action="Index" asp-route-DocumentNumber="@materialReadiness.TransferDocumentNumber">Одит</a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </dd>
                    <dt class="col-sm-3">Дата на прехвърляне</dt><dd class="col-sm-9">@(materialReadiness.TransferredOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-sm-3">Потребител</dt><dd class="col-sm-9">@(materialReadiness.TransferredByUserName ?? "-")</dd>
                </dl>
            }

            @if (materialReadiness.CanGenerateSnapshot)
            {
                <form asp-action="GenerateMaterialSnapshot" asp-route-id="@Model.Id" method="post" class="mb-3 js-safe-submit">
                    <button type="submit" class="btn btn-outline-primary" data-loading-text="Генериране..." onclick="return confirm('Да генерирам ли материалните изисквания по замразената разходна норма на поръчката?');">Генерирай материални изисквания</button>
                </form>
            }

            @if (materialReadiness.Rows.Any())
            {
                <div class="table-responsive production-table-scroll">
                    <table class="table table-sm table-striped table-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Материал</th>
                                <th class="text-end">Нужно</th>
                                <th class="text-end">Налично</th>
                                <th class="text-end">Недостиг</th>
                                <th>Мерна единица</th>
                                <th class="text-center">Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in materialReadiness.Rows)
                            {
                                var hasShortage = row.ShortageQuantity > 0;
                                var collapseId = $"allocations-{row.ProductionOrderMaterialId}";
                                <tr class="@(hasShortage ? "table-warning" : string.Empty)">
                                    <td>
                                        <strong>@row.MaterialCode</strong><br />
                                        <span>@row.MaterialName</span>
                                    </td>
                                    <td class="text-end">@row.OutstandingQuantity.ToString("N4")</td>
                                    <td class="text-end">@row.AvailableQuantity.ToString("N4")</td>
                                    <td class="text-end @(hasShortage ? "text-danger fw-bold" : string.Empty)">@row.ShortageQuantity.ToString("N4")</td>
                                    <td>@row.Unit</td>
                                    <td class="text-center"><span class="badge @(hasShortage ? "bg-danger" : "bg-success")">@row.StatusText</span></td>
                                </tr>
                                <tr>
                                    <td colspan="6">
                                        @if (row.Allocations.Any())
                                        {
                                            <button class="btn btn-sm btn-outline-secondary production-collapse-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                                <span class="toggle-icon">►</span> Разпределения
                                            </button>
                                            <div class="collapse mt-2 production-collapse" id="@collapseId">
                                                <table class="table table-sm table-bordered mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>Източник</th>
                                                            <th>Локация</th>
                                                            <th>Дестинация</th>
                                                            <th>Партида</th>
                                                            <th>Lot</th>
                                                            <th class="text-end">Количество</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var allocation in row.Allocations)
                                                        {
                                                            <tr>
                                                                <td>@allocation.SourceWarehouse</td>
                                                                <td>@allocation.SourceLocation</td>
                                                                <td>@allocation.DestinationWarehouse</td>
                                                                <td>@(allocation.BatchNumber ?? "-")</td>
                                                                <td>@(allocation.LotNumber ?? "-")</td>
                                                                <td class="text-end">@allocation.Quantity.ToString("N4")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Няма разпределения по партиди и локации за този материал.</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">Няма материали за производство по тази поръчка.</div>
            }
        }
    </div>
</div>

@if (Model.MaterialCompletionRows.Any())
{
    <div class="card mb-3">
        <div class="card-header">📦 Материално приключване</div>
        <div class="card-body">
            <div class="table-responsive production-table-scroll">
                <table class="table table-sm table-striped table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Материал</th>
                            <th class="text-end">Нужно</th>
                            <th class="text-end">Прехвърлено</th>
                            <th class="text-end">Потребено</th>
                            <th class="text-end">Върнато</th>
                            <th class="text-end">Остава в НЗП</th>
                            <th>Мерна единица</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.MaterialCompletionRows)
                        {
                            <tr>
                                <td>@row.MaterialDisplayName</td>
                                <td class="text-end">@row.RequiredQuantity.ToString("N4")</td>
                                <td class="text-end">@row.TransferredQuantity.ToString("N4")</td>
                                <td class="text-end">@row.ConsumedQuantity.ToString("N4")</td>
                                <td class="text-end">@row.ReturnedQuantity.ToString("N4")</td>
                                <td class="text-end">@row.RemainingInWip.ToString("N4")</td>
                                <td>@row.Unit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-header">📄 Документи</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">PMT</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.MaterialsTransferDocumentNumber))
                {
                    <a asp-controller="ProductionDocuments" asp-action="ViewDocument" asp-route-documentNumber="@Model.MaterialsTransferDocumentNumber">@Model.MaterialsTransferDocumentNumber</a>
                    <a class="btn btn-sm btn-outline-info ms-2" asp-controller="AuditLog" asp-action="Index" asp-route-DocumentNumber="@Model.MaterialsTransferDocumentNumber">Одит</a>
                }
                else
                {
                    <span class="text-muted">Няма създаден PMT документ.</span>
                }
            </dd>
            <dt class="col-sm-3">PMC</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.MaterialConsumptionDocumentNumber))
                {
                    <a asp-controller="ProductionDocuments" asp-action="ViewDocument" asp-route-documentNumber="@Model.MaterialConsumptionDocumentNumber">@Model.MaterialConsumptionDocumentNumber</a>
                    <a class="btn btn-sm btn-outline-info ms-2" asp-controller="AuditLog" asp-action="Index" asp-route-DocumentNumber="@Model.MaterialConsumptionDocumentNumber">Одит</a>
                }
                else
                {
                    <span class="text-muted">Няма създаден PMC документ.</span>
                }
            </dd>
            <dt class="col-sm-3">FGR</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.FinishedGoodsReceiptDocumentNumber))
                {
                    <a asp-controller="ProductionDocuments" asp-action="ViewDocument" asp-route-documentNumber="@Model.FinishedGoodsReceiptDocumentNumber">@Model.FinishedGoodsReceiptDocumentNumber</a>
                    <a class="btn btn-sm btn-outline-info ms-2" asp-controller="AuditLog" asp-action="Index" asp-route-DocumentNumber="@Model.FinishedGoodsReceiptDocumentNumber">Одит</a>
                }
                else
                {
                    <span class="text-muted">Няма създаден FGR документ.</span>
                }
            </dd>
        </dl>
    </div>
</div>

@if (Model.FinishedGoodsReceipt != null)
{
    <div class="card mb-3">
        <div class="card-header">📦 Приета готова продукция</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Документ</dt>
                <dd class="col-sm-9">
                    <a asp-controller="ProductionDocuments" asp-action="ViewDocument" asp-route-documentNumber="@Model.FinishedGoodsReceipt.DocumentNumber">@Model.FinishedGoodsReceipt.DocumentNumber</a>
                    <a class="btn btn-sm btn-outline-info ms-2" asp-controller="AuditLog" asp-action="Index" asp-route-DocumentNumber="@Model.FinishedGoodsReceipt.DocumentNumber">Одит</a>
                </dd>
                <dt class="col-sm-3">Артикул</dt><dd class="col-sm-9">@Model.FinishedGoodsReceipt.ProductDisplayName</dd>
                <dt class="col-sm-3">Размер / вариант</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.FinishedGoodsReceipt.Size) ? "-" : Model.FinishedGoodsReceipt.Size)</dd>
                <dt class="col-sm-3">Количество</dt><dd class="col-sm-9">@Model.FinishedGoodsReceipt.Quantity</dd>
                <dt class="col-sm-3">Склад</dt><dd class="col-sm-9">@Model.FinishedGoodsReceipt.Warehouse</dd>
                <dt class="col-sm-3">Дата</dt><dd class="col-sm-9">@Model.FinishedGoodsReceipt.CreatedOn.ToString("dd.MM.yyyy HH:mm")</dd>
                <dt class="col-sm-3">Потребител</dt><dd class="col-sm-9">@(Model.FinishedGoodsReceipt.CreatedByUserName ?? "-")</dd>
            </dl>
        </div>
    </div>
}

<h5>Производствени операции</h5>
<div class="table-responsive production-table-scroll">
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Последователност</th>
                <th>Операция</th>
                <th>Роля</th>
                <th class="text-end">План</th>
                <th class="text-end">Налични</th>
                <th class="text-end">Завършени</th>
                <th class="text-end">Брак</th>
                <th class="text-center">Статус</th>
                <th>Прогрес</th>
                <th>Последен отчет</th>
                <th>Последен работник</th>
                <th class="text-end">Стандартно време</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var operation in Model.Operations)
            {
                <tr>
                    <td>@operation.Sequence</td>
                    <td>@operation.OperationName</td>
                    <td>@ProductionOrderDisplayHelper.RoleText(operation.RequiredRole)</td>
                    <td class="text-end">@operation.PlannedQuantity.ToString("N4")</td>
                    <td class="text-end">@operation.AvailableQuantity.ToString("N4")</td>
                    <td class="text-end">@operation.CompletedQuantity.ToString("N4")</td>
                    <td class="text-end">@operation.RejectedQuantity.ToString("N4")</td>
                    <td class="text-center"><span class="badge @ProductionOrderDisplayHelper.OperationStatusCss(operation.Status)">@ProductionOrderDisplayHelper.OperationStatusText(operation.Status)</span></td>
                    <td style="min-width: 170px;">
                        <div class="progress production-progress">
                            <div class="progress-bar @ProductionOrderDisplayHelper.OperationStatusCss(operation.Status)" role="progressbar" style="width: @operation.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%;" aria-valuenow="@operation.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100">
                                @operation.ProgressPercent.ToString("N0")%
                            </div>
                        </div>
                    </td>
                    <td>@(operation.LastReportDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                    <td>@(operation.LastReportingWorker ?? "-")</td>
                    <td class="text-end">@(operation.StandardTimeMinutes?.ToString() ?? "-")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-success @(operation.AvailableQuantity > 0 && (operation.Status == ProductionOrderOperationStatus.Ready || operation.Status == ProductionOrderOperationStatus.InProgress) ? string.Empty : "disabled")" asp-controller="ProductionWork" asp-action="Report" asp-route-id="@operation.Id">Отчет</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h5>История на отчетена работа</h5>
@if (!Model.Operations.Any(x => x.WorkHistory.Any()))
{
    <div class="alert alert-info">Няма отчетена работа по тази производствена поръчка.</div>
}
else
{
    <div class="table-responsive production-table-scroll">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Дата/час</th>
                    <th>Операция</th>
                    <th>Работник</th>
                    <th class="text-end">Завършено</th>
                    <th class="text-end">Брак</th>
                    <th>Начало</th>
                    <th>Край</th>
                    <th>Бележки</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var operation in Model.Operations)
                {
                    foreach (var entry in operation.WorkHistory)
                    {
                        <tr>
                            <td>@entry.CreatedOn.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@operation.OperationName</td>
                            <td>@(string.IsNullOrWhiteSpace(entry.Worker) ? "-" : entry.Worker)</td>
                            <td class="text-end">@entry.ReportedCompletedQuantity.ToString("N4")</td>
                            <td class="text-end">@entry.ReportedRejectedQuantity.ToString("N4")</td>
                            <td>@(entry.WorkStartedOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            <td>@(entry.WorkEndedOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            <td>@(entry.Notes ?? "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

<div class="production-actions mb-3">
    <a class="btn btn-secondary" asp-action="Index">Назад</a>

    <a class="btn btn-outline-secondary @(Model.Status == ProductionOrderStatus.Planned ? string.Empty : "disabled")" asp-action="Edit" asp-route-id="@Model.Id">Редакция</a>

    <form asp-action="Release" asp-route-id="@Model.Id" method="post" class="d-inline js-safe-submit">
        <button type="submit" class="btn btn-outline-primary" disabled="@(Model.Status != ProductionOrderStatus.Planned)" data-loading-text="Освобождаване..." onclick="return confirm('Да освободя ли поръчката за производство?');">Освободи</button>
    </form>

    <form asp-action="Start" asp-route-id="@Model.Id" method="post" class="d-inline js-safe-submit">
        <span title="@(canStart ? string.Empty : "Липсват необходими материали или материалите вече са прехвърлени")" data-bs-toggle="tooltip">
            <button type="submit" class="btn btn-outline-success" disabled="@(!canStart)" data-loading-text="Стартиране..." onclick="return confirm('Да стартирам ли производствената поръчка и да прехвърля материалите към НЗП?');">Стартирай</button>
        </span>
    </form>

    <a class="btn btn-outline-success @(Model.Status == ProductionOrderStatus.ProductionCompleted ? string.Empty : "disabled")" asp-action="Finalize" asp-route-id="@Model.Id">Финално приключване</a>

    <a class="btn btn-outline-danger @(Model.Status == ProductionOrderStatus.Planned || Model.Status == ProductionOrderStatus.Released || Model.Status == ProductionOrderStatus.InProgress ? string.Empty : "disabled")" asp-action="Cancel" asp-route-id="@Model.Id">Отмени</a>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline js-safe-submit">
        <button type="submit" class="btn btn-outline-danger" disabled="@(Model.Status != ProductionOrderStatus.Planned)" data-loading-text="Изтриване..." onclick="return confirm('Изтриването е необратимо. Сигурни ли сте?');">Изтрий</button>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.production-collapse').forEach(function (element) {
                const key = 'production-order-' + @Model.Id + '-' + element.id;
                if (localStorage.getItem(key) === 'open') {
                    element.classList.add('show');
                    const button = document.querySelector('[data-bs-target="#' + element.id + '"]');
                    if (button) {
                        button.setAttribute('aria-expanded', 'true');
                        const icon = button.querySelector('.toggle-icon');
                        if (icon) icon.textContent = '▼';
                    }
                }
                element.addEventListener('shown.bs.collapse', function () {
                    localStorage.setItem(key, 'open');
                    const button = document.querySelector('[data-bs-target="#' + element.id + '"]');
                    const icon = button ? button.querySelector('.toggle-icon') : null;
                    if (icon) icon.textContent = '▼';
                });
                element.addEventListener('hidden.bs.collapse', function () {
                    localStorage.setItem(key, 'closed');
                    const button = document.querySelector('[data-bs-target="#' + element.id + '"]');
                    const icon = button ? button.querySelector('.toggle-icon') : null;
                    if (icon) icon.textContent = '►';
                });
            });

            document.querySelectorAll('form.js-safe-submit').forEach(function (form) {
                form.addEventListener('submit', function () {
                    const button = form.querySelector('button[type="submit"]');
                    if (!button || button.disabled) {
                        return;
                    }
                    const loadingText = button.getAttribute('data-loading-text') || 'Обработка...';
                    setTimeout(function () {
                        button.disabled = true;
                        button.innerHTML = '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>' + loadingText;
                    }, 0);
                });
            });
        });
    </script>
}
