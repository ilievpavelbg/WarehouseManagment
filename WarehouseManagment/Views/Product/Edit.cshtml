@model ProductModel

@{
    ViewData["Title"] = $"Редакция артикул {Model.SKU}";
}

<div class="app-page-header">
    <div>
        <h1>Редакция артикул</h1>
        <p>@Model.SKU - @(string.IsNullOrWhiteSpace(Model.Description) ? "без описание" : Model.Description)</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Product" asp-action="Index">Назад</a>
</div>

<div class="alert alert-success" id="successMessage" role="alert" style="display: none;"></div>
<div class="alert alert-danger" id="errorMessage" role="alert" style="display: none;"></div>

<div class="app-card">
    <form id="editForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="SKU" type="hidden" />
        <input asp-for="Id" type="hidden" />

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">SKU / Артикулен номер</label>
                <input value="@Model.SKU" class="form-control" readonly />
                <div class="form-text">SKU не се променя тук, за да се пазят POS, производство, баркод и исторически връзки.</div>
            </div>
            <div class="col-md-8">
                <label asp-for="Description" class="form-label">Описание</label>
                <input asp-for="Description" type="text" autocomplete="off" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="RetailPrice" class="form-label">Цена на дребно</label>
                <input asp-for="RetailPrice" type="number" min="0" step="0.01" autocomplete="off" class="form-control" />
                <span asp-validation-for="RetailPrice" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="WholesalePrice" class="form-label">Цена на едро</label>
                <input asp-for="WholesalePrice" type="number" min="0" step="0.01" autocomplete="off" class="form-control" />
                <span asp-validation-for="WholesalePrice" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Genre" class="form-label">Пол</label>
                <select asp-for="Genre" class="form-select">
                    <option value="">Избери пол</option>
                    @foreach (var genreValue in Enum.GetValues(typeof(WarehouseManagment.Data.Genre)))
                    {
                        <option value="@genreValue">@genreValue</option>
                    }
                </select>
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Category" class="form-label">Категория</label>
                <select asp-for="Category" id="categoryDropdown" class="form-select">
                    <option value="">Избери категория</option>
                    @foreach (var categoryValue in Enum.GetValues(typeof(WarehouseManagment.Data.Category)))
                    {
                        <option value="@categoryValue">@categoryValue</option>
                    }
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Color" class="form-label">Цвят</label>
                <select asp-for="Color" class="form-select">
                    @foreach (var colorValue in Enum.GetValues(typeof(WarehouseManagment.Data.Color)))
                    {
                        <option value="@colorValue">@colorValue</option>
                    }
                </select>
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="FirstComposition" class="form-label">Състав 1</label>
                <select asp-for="FirstComposition" class="form-select">
                    <option value="">Избери състав</option>
                    @foreach (var compositionValue in Enum.GetValues(typeof(WarehouseManagment.Data.Composition)))
                    {
                        <option value="@compositionValue">@compositionValue</option>
                    }
                </select>
                <span asp-validation-for="FirstComposition" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="SecondComposition" class="form-label">Състав 2</label>
                <select asp-for="SecondComposition" class="form-select">
                    <option value="">Избери състав</option>
                    @foreach (var compositionValue in Enum.GetValues(typeof(WarehouseManagment.Data.Composition)))
                    {
                        <option value="@compositionValue">@compositionValue</option>
                    }
                </select>
                <span asp-validation-for="SecondComposition" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-secondary" asp-controller="Product" asp-action="Index">Отказ</a>
            <button id="submitBtn" class="btn btn-primary" type="submit">Запази</button>
        </div>
    </form>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            $('#submitBtn').click(function (e) {
                e.preventDefault();

                var formData = $('#editForm').serialize();

                $.ajax({
                    type: "POST",
                    url: "/Product/Edit",
                    data: formData,
                    dataType: "json",
                    success: function (response) {
                        if (response.success === true) {
                            $('#successMessage').text(response.message);
                            $('#successMessage').show();
                            setTimeout(function () {
                                window.location.href = "/Product";
                            }, 1200);
                        } else {
                            $('#errorMessage').text(response.message);
                            $('#errorMessage').show();
                        }
                    },
                    error: function () {
                        $('#errorMessage').text("Възникна грешка при редакция на артикула.");
                        $('#errorMessage').show();
                    }
                });
            });
        })
    </script>
    <partial name="_ValidationScriptsPartial" />
}
