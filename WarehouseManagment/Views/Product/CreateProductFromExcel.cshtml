@{
    ViewData["Title"] = "Импорт артикули от Excel";
}

<div class="app-page-header">
    <div>
        <h1>Импорт артикули от Excel</h1>
        <p>Импортът запазва съществуващата структура и използва SKU от Excel файла.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Product" asp-action="Index">Назад</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var modelState in ViewData.ModelState.Values)
        {
            foreach (var error in modelState.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        }
    </div>
}

<div class="app-card">
    <form asp-action="CreateProductFromExcel" asp-controller="Product" method="post" enctype="multipart/form-data">
        <div class="row g-3 align-items-end">
            <div class="col-md-8">
                <label for="excelFile" class="form-label">Excel файл</label>
                <input type="file" class="form-control" name="excelFile" id="excelFile" accept=".xlsx,.xls" />
                <div class="form-text">Семантиката на импорта не е променяна: SKU остава водещият код от файла.</div>
            </div>
            <div class="col-md-4 d-grid">
                <button class="btn btn-primary" type="submit">Импортирай</button>
            </div>
        </div>
    </form>
</div>
