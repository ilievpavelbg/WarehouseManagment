@model ProductRoutingModel

@{
    ViewData["Title"] = "Технологичен маршрут";
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (!Model.IsEditable)
{
    <div class="alert alert-info">
        Тази версия е активна или историческа и е достъпна само за преглед. За промени създайте нова версия от активния маршрут.
    </div>
}

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    @await Html.PartialAsync("_Form", Model)
    @if (Model.IsEditable)
    {
        <button type="submit" class="btn btn-primary">Запази чернова</button>
    }
    <a class="btn btn-secondary" asp-action="Index">Назад</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
