@model List<ProductInventoryModel>

@{
    ViewData["Title"] = "Склад, наличности и баркод";
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<form asp-controller="ProductInventory" asp-action="GenerateMissingBarcodes" method="post" class="mb-3">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-primary">Генерирай липсващи баркодове</button>
</form>

@if (!Model.Any())
{
    <p>Няма намерени резултати.</p>
}
else
{
    <div class="col-12">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">SKU</th>
                    <th scope="col">Размер</th>
                    <th scope="col">Количество</th>
                    <th scope="col">Баркод</th>
                    <th scope="col">Етикет</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderBy(x => x.ProductSKU).ThenBy(x => x.Size))
                {
                    <tr>
                        <td>@item.ProductSKU</td>
                        <td>@item.Size</td>
                        <td>@item.Quantity бр.</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Barcode))
                            {
                                <code>@item.Barcode</code>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Липсва</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.Barcode))
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Label" asp-action="Index" asp-route-ProductInventoryId="@item.Id" asp-route-Quantity="1">Печат</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
