@model List<ProductRouting>

@{
    ViewData["Title"] = "Технологични маршрути";
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">Нов чернови маршрут</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>Артикул</th>
            <th>Версия</th>
            <th>Статус</th>
            <th>Брой операции</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var routing in Model)
        {
            <tr>
                <td>@routing.Product.SKU - @routing.Product.Description</td>
                <td>@routing.Version</td>
                <td>
                    @if (routing.IsActive)
                    {
                        <span class="badge bg-success">Активна</span>
                    }
                    else if (routing.HasBeenActivated)
                    {
                        <span class="badge bg-secondary">История</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Чернова</span>
                    }
                </td>
                <td>@routing.Steps.Count</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@routing.Id">Преглед</a>
                    @if (!routing.IsActive && !routing.HasBeenActivated)
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@routing.Id">Редакция</a>
                        <form asp-action="Activate" asp-route-id="@routing.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Активирай</button>
                        </form>
                    }
                    @if (routing.IsActive)
                    {
                        <form asp-action="CreateNewVersion" asp-route-id="@routing.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Нова версия</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
