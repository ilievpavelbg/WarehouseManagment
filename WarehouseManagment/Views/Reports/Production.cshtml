@model ReportsIndexModel<ProductionReportRowModel>
@{ ViewData["Title"] = "Производствена справка"; }
<div class="app-page-header"><div><h1>Производствена справка</h1><p>Поръчки, количества, статус и прогрес.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="WorkerOperations">Операции</a><a class="btn btn-outline-primary" asp-action="MaterialConsumption">Разход материали</a><a class="btn btn-outline-success" asp-action="Export" asp-route-report="production">Excel</a></div></div>
<div class="row g-3 my-3">@foreach (var kpi in Model.Kpis){<div class="col-md-4"><div class="app-stat-card border-start border-4 @kpi.CssClass"><span>@kpi.Label</span><strong>@kpi.Value</strong></div></div>}</div>
<div class="app-card"><table class="table app-table"><thead><tr><th>Поръчка</th><th>Артикул</th><th>Вариант</th><th class="text-end">План</th><th class="text-end">Годно</th><th class="text-end">Брак</th><th>Начало</th><th>Край</th><th>Статус</th><th class="text-end">Прогрес</th></tr></thead><tbody>
@foreach (var row in Model.Rows){<tr><td><a asp-controller="ProductionOrder" asp-action="Details" asp-route-id="@row.Id">@row.OrderNumber</a></td><td>@row.Product</td><td>@row.Variant</td><td class="text-end">@QuantityDisplayFormatter.Format(row.PlannedQuantity, "бр", true)</td><td class="text-end">@QuantityDisplayFormatter.Format(row.GoodQuantity, "бр", true)</td><td class="text-end">@QuantityDisplayFormatter.Format(row.RejectedQuantity, "бр", true)</td><td>@row.Start?.ToString("dd.MM.yyyy")</td><td>@row.End?.ToString("dd.MM.yyyy")</td><td>@row.Status</td><td class="text-end">@row.ProgressPercent.ToString("N0")%</td></tr>}
</tbody></table></div>
