@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav app-user-menu">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <span class="nav-link">@(User.Identity?.Name ?? "Потребител")</span>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-action="Logout" asp-controller="User">Изход</a>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-action="Login" asp-controller="User">Вход</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-action="Register" asp-controller="User">Регистрация</a>
    </li>
}
</ul>
