@model ProductionOrderCreateModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Нова производствена поръчка";
    var canCreate = Model.Readiness?.IsReady == true;
}

<h1 class="text-center">@ViewData["Title"]</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ProductId" class="form-label">Артикул</label>
            <select asp-for="ProductId" class="form-select" asp-items="@(new SelectList(Model.Products, "Id", "Text", Model.ProductId))" id="productSelector">
                <option value="">Изберете артикул...</option>
            </select>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="ProductInventoryId" class="form-label">Размер / вариант</label>
            <select asp-for="ProductInventoryId" class="form-select" asp-items="@(new SelectList(Model.ProductInventoryVariants, "Id", "Text", Model.ProductInventoryId))" id="variantSelector">
                <option value="">Изберете размер...</option>
            </select>
            @if (Model.ProductId > 0 && !Model.ProductInventoryVariants.Any())
            {
                <div class="form-text text-danger">Артикулът няма настроен размер/вариант за готова продукция.</div>
            }
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="PlannedQuantity" class="form-label">Планирано количество</label>
            <div class="input-group">
                <input asp-for="PlannedQuantity" class="form-control" />
                <span class="input-group-text">@(string.IsNullOrWhiteSpace(Model.ProductionUnit) ? "м.е." : Model.ProductionUnit)</span>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="Priority" class="form-label">Приоритет</label>
            <select asp-for="Priority" class="form-select">
                @foreach (ProductionOrderPriority priority in Enum.GetValues(typeof(ProductionOrderPriority)))
                {
                    <option value="@priority" selected="@(Model.Priority == priority)">@ProductionOrderDisplayHelper.PriorityText(priority)</option>
                }
            </select>
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="PlannedStartDate" class="form-label">Планиран старт</label>
            <input asp-for="PlannedStartDate" type="date" class="form-control" />
        </div>
        <div class="col-md-3 mb-3">
            <label asp-for="PlannedEndDate" class="form-label">Планиран край</label>
            <input asp-for="PlannedEndDate" type="date" class="form-control" />
        </div>
        <div class="col-12 mb-3">
            <label asp-for="Notes" class="form-label">Бележки</label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        </div>
    </div>

    @if (Model.Readiness != null)
    {
        var readinessItems = new[]
        {
            new { Label = "Производствен профил", Ok = Model.Readiness.HasActiveProductionProfile, Value = Model.Readiness.ProductionProfileText ?? string.Empty },
            new { Label = "Разходна норма", Ok = Model.Readiness.HasActiveBillOfMaterials, Value = Model.Readiness.BillOfMaterialsVersion.HasValue ? $"Версия {Model.Readiness.BillOfMaterialsVersion}" : string.Empty },
            new { Label = "Технологичен маршрут", Ok = Model.Readiness.HasActiveRouting && Model.Readiness.RoutingStepsCount > 0, Value = Model.Readiness.ProductRoutingVersion.HasValue ? $"Версия {Model.Readiness.ProductRoutingVersion}, операции {Model.Readiness.RoutingStepsCount}" : string.Empty },
            new { Label = "Калкулация", Ok = true, Value = Model.Readiness.CostCalculationText },
            new { Label = "Мерна единица", Ok = !string.IsNullOrWhiteSpace(Model.Readiness.ProductionUnit), Value = Model.Readiness.ProductionUnit ?? string.Empty },
            new { Label = "Склад производство / НЗП", Ok = Model.Readiness.HasDefaultWipWarehouse, Value = Model.Readiness.WipWarehouse ?? string.Empty },
            new { Label = "Склад готова продукция", Ok = Model.Readiness.HasDefaultFinishedGoodsWarehouse, Value = Model.Readiness.FinishedGoodsWarehouse ?? string.Empty },
            new { Label = "Размер / вариант", Ok = Model.Readiness.HasValidProductInventory, Value = Model.Readiness.ProductInventoryText ?? string.Empty }
        };

        <div class="card mb-3">
            <div class="card-header">Готовност за производство</div>
            <div class="card-body">
                <div class="row g-2">
                    @foreach (var item in readinessItems)
                    {
                        <div class="col-md-4">
                            <div class="border rounded p-2 h-100">
                                <div class="small text-muted">@item.Label</div>
                                @if (item.Ok)
                                {
                                    <span class="badge bg-success">OK</span>
                                    <span>@(string.IsNullOrWhiteSpace(item.Value) ? "Не е зададена" : item.Value)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Липсва</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="alert @(canCreate ? "alert-success" : "alert-danger")">
            @(canCreate ? "Готово за създаване." : "Поръчката не може да бъде създадена. Попълнете липсващите настройки.")
        </div>
    }
    else
    {
        <div class="alert alert-info">Изберете артикул, за да се провери готовността за производство.</div>
    }

    <button type="submit" class="btn btn-primary" disabled="@(!canCreate)">Създай поръчка</button>
    <a class="btn btn-secondary" asp-action="Index">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const productSelector = document.getElementById('productSelector');
            const variantSelector = document.getElementById('variantSelector');
            const createUrl = '@Url.Action("Create", "ProductionOrder")';

            productSelector.addEventListener('change', function () {
                if (productSelector.value) {
                    window.location.href = createUrl + '?productId=' + encodeURIComponent(productSelector.value);
                } else {
                    window.location.href = createUrl;
                }
            });

            variantSelector.addEventListener('change', function () {
                if (!productSelector.value) {
                    return;
                }

                let url = createUrl + '?productId=' + encodeURIComponent(productSelector.value);
                if (variantSelector.value) {
                    url += '&productInventoryId=' + encodeURIComponent(variantSelector.value);
                }

                window.location.href = url;
            });
        });
    </script>
}
