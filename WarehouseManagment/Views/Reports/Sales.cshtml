@model ReportsIndexModel<SalesReportRowModel>
@{
    ViewData["Title"] = "Справка продажби";
}
<div class="app-page-header"><div><h1>Справка продажби</h1><p>POS документи. Сторнираните продажби се показват отделно и не участват в нетните KPI.</p></div><a class="btn btn-outline-success" asp-action="Export" asp-route-report="sales" asp-route-DateFrom="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" asp-route-Search="@Model.Filter.Search" asp-route-DocumentNumber="@Model.Filter.DocumentNumber">Excel</a></div>
<form method="get" class="app-filter-panel row g-2 align-items-end">
    <div class="col-md-2"><label class="form-label">Дата от</label><input type="date" name="DateFrom" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label">Дата до</label><input type="date" name="DateTo" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label">Документ</label><input name="DocumentNumber" value="@Model.Filter.DocumentNumber" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label">Артикул</label><input name="Search" value="@Model.Filter.Search" class="form-control" /></div>
    <div class="col-md-2"><label class="form-label">Оператор</label><input name="Operator" value="@Model.Filter.Operator" class="form-control" /></div>
    <div class="col-md-2"><button class="btn btn-primary w-100">Филтър</button></div>
</form>
<div class="row g-3 my-3">@foreach (var kpi in Model.Kpis){<div class="col-md-3 col-xl"><div class="app-stat-card border-start border-4 @kpi.CssClass"><span>@kpi.Label</span><strong>@kpi.Value</strong></div></div>}</div>
<div class="app-card"><table class="table app-table"><thead><tr><th>Дата</th><th>Документ</th><th>Оператор</th><th class="text-end">Редове</th><th class="text-end">Количество</th><th class="text-end">Общо</th><th>Плащане</th><th>Статус</th></tr></thead><tbody>
@foreach (var row in Model.Rows){<tr><td>@row.Date.ToString("dd.MM.yyyy HH:mm")</td><td><a asp-controller="Pos" asp-action="Details" asp-route-id="@row.Id">@row.DocumentNumber</a></td><td>@row.Operator</td><td class="text-end">@row.Items</td><td class="text-end">@row.Quantity</td><td class="text-end">@row.Total.ToString("N2") EUR</td><td>@row.Payment</td><td><span class="badge @(row.IsReversed ? "bg-danger" : "bg-success")">@row.Status</span></td></tr>}
</tbody></table></div>
