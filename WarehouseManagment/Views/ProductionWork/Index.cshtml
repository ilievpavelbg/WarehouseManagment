@model ProductionWorkTaskIndexModel

@{
    ViewData["Title"] = "Моите задачи";
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">Номер на поръчка</label>
        <input asp-for="Filter.OrderNumber" name="OrderNumber" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Операция</label>
        <input asp-for="Filter.Operation" name="Operation" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Планиран край до</label>
        <input asp-for="Filter.PlannedEndDate" name="PlannedEndDate" type="date" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Статус</label>
        <select asp-for="Filter.Status" name="Status" class="form-select">
            <option value="">Всички</option>
            @foreach (ProductionOrderOperationStatus status in Enum.GetValues(typeof(ProductionOrderOperationStatus)))
            {
                if (Model.Filter.Status == status)
                {
                    <option value="@status" selected>@ProductionOrderDisplayHelper.OperationStatusText(status)</option>
                }
                else
                {
                    <option value="@status">@ProductionOrderDisplayHelper.OperationStatusText(status)</option>
                }
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary me-2">Филтър</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Изчисти</a>
    </div>
</form>

@if (!Model.Rows.Any())
{
    <div class="alert alert-info">Няма налични производствени задачи.</div>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>Поръчка</th>
                <th>Артикул</th>
                <th>Операция</th>
                <th>Роля</th>
                <th>Планирано</th>
                <th>Налично за работа</th>
                <th>Завършено</th>
                <th>Брак</th>
                <th>Планиран край</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.OrderNumber</td>
                    <td>@row.ProductDisplayName</td>
                    <td>@row.OperationName</td>
                    <td>@ProductionOrderDisplayHelper.RoleText(row.RequiredRole)</td>
                    <td>@row.PlannedQuantity.ToString("N4") @row.UnitOfMeasure</td>
                    <td>@row.AvailableQuantity.ToString("N4") @row.UnitOfMeasure</td>
                    <td>@row.CompletedQuantity.ToString("N4") @row.UnitOfMeasure</td>
                    <td>@row.RejectedQuantity.ToString("N4") @row.UnitOfMeasure</td>
                    <td>@(row.PlannedEndDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                    <td><span class="badge @ProductionOrderDisplayHelper.OperationStatusCss(row.Status)">@ProductionOrderDisplayHelper.OperationStatusText(row.Status)</span></td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@row.ProductionOrderOperationId">Преглед</a>
                        <a class="btn btn-sm btn-success" asp-action="Report" asp-route-id="@row.ProductionOrderOperationId">Отчети работа</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : string.Empty)">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-orderNumber="@Model.Filter.OrderNumber" asp-route-operation="@Model.Filter.Operation" asp-route-plannedEndDate="@Model.Filter.PlannedEndDate?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Filter.Status">Назад</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : string.Empty)">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-orderNumber="@Model.Filter.OrderNumber" asp-route-operation="@Model.Filter.Operation" asp-route-plannedEndDate="@Model.Filter.PlannedEndDate?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Filter.Status">Напред</a>
            </li>
        </ul>
    </nav>
}
