@model List<ProductionOperation>

@{
    ViewData["Title"] = "Производствени операции";
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">Нова операция</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Код</th>
            <th>Име</th>
            <th>Последователност</th>
            <th>Роля</th>
            <th>Активна</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var operation in Model)
        {
            <tr>
                <td>@operation.Code</td>
                <td>@operation.Name</td>
                <td>@operation.DefaultSequence</td>
                <td>@operation.RequiredRole</td>
                <td>@(operation.IsActive ? "Да" : "Не")</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@operation.Id">Редакция</a>
                </td>
            </tr>
        }
    </tbody>
</table>
