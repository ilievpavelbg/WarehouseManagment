@model ProductionOrderIndexModel

@{
    ViewData["Title"] = "Производствени поръчки";
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">Нова производствена поръчка</a>
</div>

<form asp-controller="ProductionOrder" asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <label class="form-label">Поръчка</label>
        <input type="text" name="OrderNumber" value="@Model.Filter.OrderNumber" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Артикул</label>
        <select name="ProductId" class="form-select">
            <option value="">Всички</option>
            @foreach (var product in Model.Products)
            {
                <option value="@product.Id" selected="@(Model.Filter.ProductId == product.Id)">@product.Text</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Статус</label>
        <select name="Status" class="form-select">
            <option value="">Всички</option>
            @foreach (ProductionOrderStatus status in Enum.GetValues(typeof(ProductionOrderStatus)))
            {
                <option value="@((int)status)" selected="@(Model.Filter.Status == status)">@ProductionOrderDisplayHelper.StatusText(status)</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Дата от</label>
        <input type="date" name="DateFrom" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Дата до</label>
        <input type="date" name="DateTo" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-1 d-flex align-items-end">
        <div class="form-check">
            <input type="checkbox" name="OverdueOnly" value="true" class="form-check-input" checked="@Model.Filter.OverdueOnly" />
            <input type="hidden" name="OverdueOnly" value="false" />
            <label class="form-check-label">Просрочени</label>
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-primary">Филтър</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Изчисти</a>
    </div>
</form>

@if (!Model.Rows.Any())
{
    <div class="alert alert-info">Няма намерени производствени поръчки по избраните критерии.</div>
}
else
{
    <div class="table-responsive production-table-scroll">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Поръчка</th>
                    <th>Артикул</th>
                    <th class="text-end">Планирано количество</th>
                    <th>Мерна единица</th>
                    <th>Планиран старт</th>
                    <th>Планиран край</th>
                    <th class="text-center">Статус</th>
                    <th>Прогрес</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>
                            @row.OrderNumber
                            @if (row.IsOverdue)
                            {
                                <span class="badge bg-danger ms-1">Просрочена</span>
                            }
                        </td>
                        <td>@row.ProductDisplayName</td>
                        <td class="text-end">@QuantityDisplayFormatter.Format(row.PlannedQuantity, row.UnitOfMeasure)</td>
                        <td>@row.UnitOfMeasure</td>
                        <td>@(row.PlannedStartDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td>@(row.PlannedEndDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td class="text-center"><span class="badge @ProductionOrderDisplayHelper.StatusCss(row.Status)">@ProductionOrderDisplayHelper.StatusText(row.Status)</span></td>
                        <td style="min-width: 150px;">
                            <div class="progress production-progress">
                                <div class="progress-bar @ProductionOrderDisplayHelper.StatusCss(row.Status)" role="progressbar" style="width: @row.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%;">
                                    @row.ProgressPercent.ToString("N0")%
                                </div>
                            </div>
                        </td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@row.Id">Преглед</a>
                            <a class="btn btn-sm btn-outline-secondary @(row.Status == ProductionOrderStatus.Planned ? string.Empty : "disabled")" asp-action="Edit" asp-route-id="@row.Id">Редакция</a>
                            <form asp-action="Release" asp-route-id="@row.Id" method="post" class="d-inline js-safe-submit">
                                <button type="submit" class="btn btn-sm btn-outline-primary" disabled="@(row.Status != ProductionOrderStatus.Planned)" data-loading-text="Освобождаване..." onclick="return confirm('Да освободя ли поръчката за производство?');">Освободи</button>
                            </form>
                            <form asp-action="Start" asp-route-id="@row.Id" method="post" class="d-inline js-safe-submit">
                                <button type="submit" class="btn btn-sm btn-outline-success" disabled="@(row.Status != ProductionOrderStatus.Released)" data-loading-text="Стартиране..." onclick="return confirm('Да стартирам ли производствената поръчка?');">Старт</button>
                            </form>
                            <a class="btn btn-sm btn-outline-success @(row.Status == ProductionOrderStatus.ProductionCompleted ? string.Empty : "disabled")" asp-action="Finalize" asp-route-id="@row.Id">Приключи</a>
                            <a class="btn btn-sm btn-outline-danger @(row.Status == ProductionOrderStatus.Planned || row.Status == ProductionOrderStatus.Released || row.Status == ProductionOrderStatus.InProgress ? string.Empty : "disabled")" asp-action="Cancel" asp-route-id="@row.Id">Отмени</a>
                            <form asp-action="Delete" asp-route-id="@row.Id" method="post" class="d-inline js-safe-submit">
                                <button type="submit" class="btn btn-sm btn-outline-danger" disabled="@(row.Status != ProductionOrderStatus.Planned)" data-loading-text="Изтриване..." onclick="return confirm('Изтриването е необратимо. Сигурни ли сте?');">Изтрий</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : string.Empty)">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-orderNumber="@Model.Filter.OrderNumber" asp-route-productId="@Model.Filter.ProductId" asp-route-status="@((int?)Model.Filter.Status)" asp-route-dateFrom="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" asp-route-overdueOnly="@Model.Filter.OverdueOnly">Назад</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : string.Empty)">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-orderNumber="@Model.Filter.OrderNumber" asp-route-productId="@Model.Filter.ProductId" asp-route-status="@((int?)Model.Filter.Status)" asp-route-dateFrom="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" asp-route-overdueOnly="@Model.Filter.OverdueOnly">Напред</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('form.js-safe-submit').forEach(function (form) {
                form.addEventListener('submit', function () {
                    const button = form.querySelector('button[type="submit"]');
                    if (!button || button.disabled) {
                        return;
                    }
                    const loadingText = button.getAttribute('data-loading-text') || 'Обработка...';
                    setTimeout(function () {
                        button.disabled = true;
                        button.innerHTML = '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>' + loadingText;
                    }, 0);
                });
            });
        });
    </script>
}
