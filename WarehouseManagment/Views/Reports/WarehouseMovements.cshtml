@model ReportsIndexModel<WarehouseMovementReportRowModel>
@{ ViewData["Title"] = "Движения склад"; }
<div class="app-page-header"><div><h1>Движения склад</h1><p>История на складови движения по материали и готови продукти.</p></div><a class="btn btn-outline-success" asp-action="Export" asp-route-report="movements">Excel</a></div>
<form method="get" class="app-filter-panel row g-2 align-items-end"><div class="col-md-2"><label class="form-label">Дата от</label><input type="date" name="DateFrom" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-2"><label class="form-label">Дата до</label><input type="date" name="DateTo" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-4"><label class="form-label">Търсене</label><input name="Search" value="@Model.Filter.Search" class="form-control" /></div><div class="col-md-2"><button class="btn btn-primary w-100">Филтър</button></div></form>
<div class="app-card"><table class="table app-table"><thead><tr><th>Дата</th><th>Движение</th><th>Артикул/материал</th><th class="text-end">Количество</th><th>Източник</th><th>Получател</th><th>Документ</th><th>Потребител</th></tr></thead><tbody>
@foreach (var row in Model.Rows){<tr><td>@row.Date.ToString("dd.MM.yyyy HH:mm")</td><td>@row.Movement</td><td>@row.Item</td><td class="text-end">@QuantityDisplayFormatter.FormatSigned(row.Quantity)</td><td>@row.Source</td><td>@row.Destination</td><td>@row.DocumentNumber</td><td>@row.User</td></tr>}
</tbody></table></div>
