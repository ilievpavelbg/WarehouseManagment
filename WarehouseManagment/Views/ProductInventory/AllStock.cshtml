@using WarehouseManagment.Constants
@model List<ProductInventoryModel>

@{
    ViewData["Title"] = "Склад, наличности и баркод";
    var canManageBarcodes = User.IsInRole(ApplicationRoles.Administrator) || User.IsInRole(ApplicationRoles.SalesManager);
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (canManageBarcodes)
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <form asp-controller="ProductInventory" asp-action="GenerateMissingBarcodes" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary">Генерирай липсващи баркодове</button>
        </form>
        <form asp-controller="ProductInventory" asp-action="FillMissingBarcodeMetadata" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary">Попълни липсващи метаданни</button>
        </form>
    </div>
}

@if (!Model.Any())
{
    <p>Няма намерени резултати.</p>
}
else
{
    <div class="col-12">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">SKU</th>
                    <th scope="col">Размер</th>
                    <th scope="col">Количество</th>
                    <th scope="col">Баркод</th>
                    <th scope="col">Метаданни</th>
                    <th scope="col">Етикет</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderBy(x => x.ProductSKU).ThenBy(x => x.Size))
                {
                    <tr>
                        <td>@item.ProductSKU</td>
                        <td>@item.Size</td>
                        <td>@item.Quantity бр.</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.BarcodeValue))
                            {
                                <code>@item.BarcodeValue</code>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Липсва</span>
                            }
                        </td>
                        <td class="small">
                            @if (!string.IsNullOrWhiteSpace(item.BarcodeValue))
                            {
                                <div><strong>Тип:</strong> @(item.BarcodeType ?? "-")</div>
                                <div><strong>Генериран на:</strong> @(item.BarcodeGeneratedOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                                <div><strong>Генериран от:</strong> @(item.BarcodeGeneratedByUserNameSnapshot ?? "-")</div>
                                <div><strong>Последно отпечатан:</strong> @(item.BarcodePrintedOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div>
                                <div><strong>Отпечатани етикети:</strong> @item.BarcodePrintCount</div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(item.BarcodeValue))
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Label" asp-action="Index" asp-route-ProductInventoryId="@item.Id" asp-route-Quantity="1">Печат</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
