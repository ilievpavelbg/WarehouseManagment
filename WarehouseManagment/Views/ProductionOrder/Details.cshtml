@model ProductionOrderDetailsModel

@{
    ViewData["Title"] = "Производствена поръчка";
}

<h1 class="text-center">@Model.OrderNumber</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="mb-3">
    <div class="d-flex justify-content-between">
        <span>Общ прогрес</span>
        <strong>@Model.ProgressPercent.ToString("N2")%</strong>
    </div>
    <div class="progress">
        <div class="progress-bar" role="progressbar" style="width: @Model.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%;" aria-valuenow="@Model.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Основна информация</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Поръчка</dt><dd class="col-sm-7">@Model.OrderNumber</dd>
                    <dt class="col-sm-5">Артикул</dt><dd class="col-sm-7">@Model.ProductDisplayName</dd>
                    <dt class="col-sm-5">Производствено име</dt><dd class="col-sm-7">@Model.ProductionName</dd>
                    <dt class="col-sm-5">Планирано количество</dt><dd class="col-sm-7">@Model.PlannedQuantity.ToString("N4") @Model.UnitOfMeasure</dd>
                    <dt class="col-sm-5">Приоритет</dt><dd class="col-sm-7">@ProductionOrderDisplayHelper.PriorityText(Model.Priority)</dd>
                    <dt class="col-sm-5">Статус</dt><dd class="col-sm-7"><span class="badge @ProductionOrderDisplayHelper.StatusCss(Model.Status)">@ProductionOrderDisplayHelper.StatusText(Model.Status)</span></dd>
                    <dt class="col-sm-5">Прогрес</dt><dd class="col-sm-7">@Model.ProgressPercent.ToString("N2")%</dd>
                    <dt class="col-sm-5">Бележки</dt><dd class="col-sm-7">@(Model.Notes ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Използвани версии</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Разходна норма</dt><dd class="col-sm-7">Версия @Model.BillOfMaterialsVersion</dd>
                    <dt class="col-sm-5">Технологичен маршрут</dt><dd class="col-sm-7">Версия @Model.ProductRoutingVersion</dd>
                    <dt class="col-sm-5">Калкулация</dt><dd class="col-sm-7">@Model.CostCalculationText</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Складове</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Склад производство / НЗП</dt><dd class="col-sm-7">@Model.WipWarehouse</dd>
                    <dt class="col-sm-5">Склад готова продукция</dt><dd class="col-sm-7">@Model.FinishedGoodsWarehouse</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">История / timestamps</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Планиран старт</dt><dd class="col-sm-7">@(Model.PlannedStartDate?.ToString("dd.MM.yyyy") ?? "-")</dd>
                    <dt class="col-sm-5">Планиран край</dt><dd class="col-sm-7">@(Model.PlannedEndDate?.ToString("dd.MM.yyyy") ?? "-")</dd>
                    <dt class="col-sm-5">Реален старт</dt><dd class="col-sm-7">@(Model.ActualStartDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-sm-5">Реален край</dt><dd class="col-sm-7">@(Model.ActualEndDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-sm-5">Създадена</dt><dd class="col-sm-7">@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</dd>
                    <dt class="col-sm-5">Създал</dt><dd class="col-sm-7">@(Model.CreatedByUserId ?? "-")</dd>
                    <dt class="col-sm-5">Стартирал</dt><dd class="col-sm-7">@(Model.StartedByUserId ?? "-")</dd>
                    <dt class="col-sm-5">Завършил</dt><dd class="col-sm-7">@(Model.CompletedByUserId ?? "-")</dd>
                    @if (Model.Status == ProductionOrderStatus.Cancelled)
                    {
                        <dt class="col-sm-5">Отменена на</dt><dd class="col-sm-7">@(Model.CancelledOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                        <dt class="col-sm-5">Отменил</dt><dd class="col-sm-7">@(Model.CancelledByUserId ?? "-")</dd>
                        <dt class="col-sm-5">Причина</dt><dd class="col-sm-7">@Model.CancellationReason</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

<h5>Производствени операции</h5>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Последователност</th>
            <th>Операция</th>
            <th>Роля</th>
            <th>План</th>
            <th>Налични</th>
            <th>Завършени</th>
            <th>Брак</th>
            <th>Статус</th>
            <th>Прогрес</th>
            <th>Последен отчет</th>
            <th>Последен работник</th>
            <th>Стандартно време</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var operation in Model.Operations)
        {
            <tr>
                <td>@operation.Sequence</td>
                <td>@operation.OperationName</td>
                <td>@operation.RequiredRole</td>
                <td>@operation.PlannedQuantity.ToString("N4")</td>
                <td>@operation.AvailableQuantity.ToString("N4")</td>
                <td>@operation.CompletedQuantity.ToString("N4")</td>
                <td>@operation.RejectedQuantity.ToString("N4")</td>
                <td><span class="badge @ProductionOrderDisplayHelper.OperationStatusCss(operation.Status)">@ProductionOrderDisplayHelper.OperationStatusText(operation.Status)</span></td>
                <td style="min-width: 160px;">
                    <div class="progress">
                        <div class="progress-bar" role="progressbar" style="width: @operation.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%;" aria-valuenow="@operation.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100">
                            @operation.ProgressPercent.ToString("N0")%
                        </div>
                    </div>
                    @if (operation.Status == ProductionOrderOperationStatus.Ready || operation.Status == ProductionOrderOperationStatus.InProgress)
                    {
                        <span class="badge bg-warning text-dark mt-1">Активна операция</span>
                    }
                </td>
                <td>@(operation.LastReportDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                <td>@(operation.LastReportingWorker ?? "-")</td>
                <td>@(operation.StandardTimeMinutes?.ToString() ?? "-")</td>
                <td>
                    @if (operation.AvailableQuantity > 0 && (operation.Status == ProductionOrderOperationStatus.Ready || operation.Status == ProductionOrderOperationStatus.InProgress))
                    {
                        <a class="btn btn-sm btn-outline-success" asp-controller="ProductionWork" asp-action="Report" asp-route-id="@operation.Id">Отчет</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<h5>История на отчетена работа</h5>
@if (!Model.Operations.Any(x => x.WorkHistory.Any()))
{
    <div class="alert alert-info">Няма отчетена работа по тази производствена поръчка.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Дата/час</th>
                <th>Операция</th>
                <th>Работник</th>
                <th>Завършено</th>
                <th>Брак</th>
                <th>Начало</th>
                <th>Край</th>
                <th>Бележки</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var operation in Model.Operations)
            {
                foreach (var entry in operation.WorkHistory)
                {
                    <tr>
                        <td>@entry.CreatedOn.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@operation.OperationName</td>
                        <td>@(string.IsNullOrWhiteSpace(entry.Worker) ? "-" : entry.Worker)</td>
                        <td>@entry.ReportedCompletedQuantity.ToString("N4")</td>
                        <td>@entry.ReportedRejectedQuantity.ToString("N4")</td>
                        <td>@(entry.WorkStartedOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                        <td>@(entry.WorkEndedOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                        <td>@(entry.Notes ?? "-")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

<div class="mb-3">
    @if (Model.Status == ProductionOrderStatus.Planned)
    {
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Редакция</a>
        <form asp-action="Release" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-primary" onclick="return confirm('Да освободя ли поръчката за производство?');">Освободи</button>
        </form>
        <a class="btn btn-outline-danger" asp-action="Cancel" asp-route-id="@Model.Id">Отмени</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Изтриването е необратимо. Сигурни ли сте?');">Изтрий</button>
        </form>
    }
    @if (Model.Status == ProductionOrderStatus.Released)
    {
        <form asp-action="Start" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-success" onclick="return confirm('Да стартирам ли производствената поръчка?');">Стартирай</button>
        </form>
        <a class="btn btn-outline-danger" asp-action="Cancel" asp-route-id="@Model.Id">Отмени</a>
    }
    @if (Model.Status == ProductionOrderStatus.InProgress)
    {
        <a class="btn btn-outline-danger" asp-action="Cancel" asp-route-id="@Model.Id">Отмени</a>
    }
    <a class="btn btn-secondary" asp-action="Index">Назад</a>
</div>
