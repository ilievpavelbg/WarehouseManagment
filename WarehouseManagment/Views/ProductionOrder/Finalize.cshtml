@model ProductionFinalizeModel

@{
    ViewData["Title"] = "Финално приключване на производствена поръчка";
}

<h1 class="text-center">@ViewData["Title"]</h1>

<form asp-action="Finalize" method="post" class="js-safe-submit">
    <input type="hidden" asp-for="ProductionOrderId" />
    <div asp-validation-summary="All" class="text-danger"></div>

    @if (!Model.CanFinalize && !string.IsNullOrWhiteSpace(Model.BlockingMessage))
    {
        <div class="alert alert-danger">@Model.BlockingMessage</div>
    }

    <div class="card mb-3">
        <div class="card-header">Основна информация</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Поръчка</dt><dd class="col-sm-8">@Model.OrderNumber</dd>
                <dt class="col-sm-4">Артикул</dt><dd class="col-sm-8">@Model.ProductDisplayName</dd>
                <dt class="col-sm-4">Размер / вариант</dt><dd class="col-sm-8">@Model.SizeVariant</dd>
                <dt class="col-sm-4">Планирано количество</dt><dd class="col-sm-8">@QuantityDisplayFormatter.Format(Model.PlannedQuantity, Model.UnitOfMeasure, true)</dd>
                <dt class="col-sm-4">Готово добро количество</dt><dd class="col-sm-8">@QuantityDisplayFormatter.Format(Model.FinalGoodQuantity, Model.UnitOfMeasure, true)</dd>
                <dt class="col-sm-4">Брак общо</dt><dd class="col-sm-8">@QuantityDisplayFormatter.Format(Model.TotalRejectQuantity, Model.UnitOfMeasure, true)</dd>
                <dt class="col-sm-4">Склад готова продукция</dt><dd class="col-sm-8">@Model.FinishedGoodsWarehouse</dd>
                <dt class="col-sm-4">Склад НЗП</dt><dd class="col-sm-8">@Model.WipWarehouse</dd>
            </dl>
        </div>
    </div>

    <div class="alert alert-info">
        Непотребените материали остават в склада НЗП, освен ако изрично не въведете количество за връщане към склада източник. Връщането създава отделен PMR документ.
    </div>

    <div class="card mb-3">
        <div class="card-header">📦 Материали</div>
        @if (!Model.Materials.Any())
        {
            <div class="card-body">
                <div class="alert alert-info mb-0">Няма материали за финално приключване по тази производствена поръчка.</div>
            </div>
        }
        else
        {
            <div class="table-responsive production-table-scroll">
                <table class="table table-striped table-bordered mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Материал</th>
                            <th class="text-end">Необходимо</th>
                            <th class="text-end">Прехвърлено</th>
                            <th class="text-end">Вече потребено</th>
                            <th class="text-end">Потвърдено потребление</th>
                            <th class="text-end">Остава в НЗП</th>
                            <th class="text-end">Връщане към източник</th>
                            <th class="text-end">НЗП след връщане</th>
                            <th>Мерна единица</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Materials.Count; i++)
                        {
                            <tr>
                                <td>
                                    @Model.Materials[i].MaterialDisplayName
                                    <input type="hidden" asp-for="Materials[i].ProductionOrderMaterialId" />
                                    <input type="hidden" asp-for="Materials[i].MaterialDisplayName" />
                                    <input type="hidden" asp-for="Materials[i].Unit" />
                                    <input type="hidden" asp-for="Materials[i].RequiredQuantity" />
                                    <input type="hidden" asp-for="Materials[i].TransferredQuantity" />
                                    <input type="hidden" asp-for="Materials[i].AlreadyConsumedQuantity" />
                                    <input type="hidden" asp-for="Materials[i].ReturnedQuantity" />
                                </td>
                                <td class="text-end">@QuantityDisplayFormatter.Format(Model.Materials[i].RequiredQuantity, Model.Materials[i].Unit, true)</td>
                                <td class="text-end">@QuantityDisplayFormatter.Format(Model.Materials[i].TransferredQuantity, Model.Materials[i].Unit, true)</td>
                                <td class="text-end">@QuantityDisplayFormatter.Format(Model.Materials[i].AlreadyConsumedQuantity, Model.Materials[i].Unit, true)</td>
                                <td>
                                    <input asp-for="Materials[i].ProposedConsumedQuantity" class="form-control text-end js-consumed-quantity" />
                                </td>
                                <td class="text-end js-remaining-before-return"
                                    data-transferred="@Model.Materials[i].TransferredQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-consumed="@Model.Materials[i].AlreadyConsumedQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-returned="@Model.Materials[i].ReturnedQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-unit="@Model.Materials[i].Unit">
                                    @QuantityDisplayFormatter.Format(Model.Materials[i].RemainingAfterFinalization, Model.Materials[i].Unit, true)
                                </td>
                                <td>
                                    <input asp-for="Materials[i].ReturnQuantity" class="form-control text-end js-return-quantity" />
                                    <div class="form-text">0 = остава в НЗП</div>
                                </td>
                                <td class="text-end js-remaining-after-return">@QuantityDisplayFormatter.Format(Model.Materials[i].RemainingInWipAfterReturn, Model.Materials[i].Unit, true)</td>
                                <td>@Model.Materials[i].Unit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card mb-3">
        <div class="card-header">📄 Документи</div>
        <div class="card-body">
            <ul class="mb-0">
                <li>PMC документ за потребление на материали.</li>
                <li>PMR документ за връщане на неизползвани материали, само ако е въведено количество за връщане.</li>
                <li>FGR документ за приемане на готова продукция.</li>
            </ul>
        </div>
    </div>

    <div class="production-actions">
        <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.ProductionOrderId">Назад</a>
        <button type="submit" class="btn btn-success" disabled="@(!Model.CanFinalize)" data-loading-text="Приключване..." onclick="return confirm('Да приключа ли производството и да създам PMC/FGR документи?');">Приключи производството</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function parseDecimal(value) {
                const normalized = (value || '0').toString().replace(',', '.');
                const parsed = Number.parseFloat(normalized);
                return Number.isFinite(parsed) ? parsed : 0;
            }

            function formatQuantity(value, unit) {
                const safeValue = Math.max(0, value);
                if ((unit || '').trim().toLowerCase() === 'бр') {
                    return Math.round(safeValue).toString() + ' ' + unit;
                }

                return safeValue.toFixed(2) + (unit ? ' ' + unit : '');
            }

            function refreshMaterialRemainder(row) {
                const remainingCell = row.querySelector('.js-remaining-before-return');
                const afterReturnCell = row.querySelector('.js-remaining-after-return');
                const consumedInput = row.querySelector('.js-consumed-quantity');
                const returnInput = row.querySelector('.js-return-quantity');
                if (!remainingCell || !afterReturnCell || !consumedInput || !returnInput) {
                    return;
                }

                const transferred = parseDecimal(remainingCell.dataset.transferred);
                const alreadyConsumed = parseDecimal(remainingCell.dataset.consumed);
                const alreadyReturned = parseDecimal(remainingCell.dataset.returned);
                const proposedConsumed = parseDecimal(consumedInput.value);
                const proposedReturn = parseDecimal(returnInput.value);
                const unit = remainingCell.dataset.unit || '';
                const remainingBeforeReturn = transferred - alreadyConsumed - alreadyReturned - proposedConsumed;
                const remainingAfterReturn = remainingBeforeReturn - proposedReturn;

                remainingCell.textContent = formatQuantity(remainingBeforeReturn, unit);
                afterReturnCell.textContent = formatQuantity(remainingAfterReturn, unit);
            }

            document.querySelectorAll('tbody tr').forEach(function (row) {
                row.querySelectorAll('.js-consumed-quantity, .js-return-quantity').forEach(function (input) {
                    input.addEventListener('input', function () {
                        refreshMaterialRemainder(row);
                    });
                });
                refreshMaterialRemainder(row);
            });

            document.querySelectorAll('form.js-safe-submit').forEach(function (form) {
                form.addEventListener('submit', function () {
                    const button = form.querySelector('button[type="submit"]');
                    if (!button || button.disabled) {
                        return;
                    }
                    const loadingText = button.getAttribute('data-loading-text') || 'Обработка...';
                    setTimeout(function () {
                        button.disabled = true;
                        button.innerHTML = '<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>' + loadingText;
                    }, 0);
                });
            });
        });
    </script>
}
