@using System.ComponentModel
@using WarehouseManagment.Data
@model PosIndexModel

@{
    ViewData["Title"] = "POS продажба";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">POS продажба</h1>
    <div class="text-muted">Оператор: @(Model.OperatorName ?? "-")</div>
</div>

@Html.AntiForgeryToken()
<div id="posMessage" class="alert d-none" role="alert"></div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <label class="form-label fw-bold fs-5" for="barcodeInput">Сканирай баркод</label>
                <form id="scanForm" class="input-group input-group-lg mb-3">
                    <input id="barcodeInput" class="form-control" autocomplete="off" autofocus placeholder="Баркод" />
                    <button class="btn btn-success" type="submit">Добави</button>
                </form>

                <label class="form-label fw-bold" for="searchInput">Търсене на артикул</label>
                <form id="searchForm" class="input-group mb-3">
                    <input id="searchInput" class="form-control" autocomplete="off" placeholder="SKU, описание или размер" />
                    <button id="searchButton" class="btn btn-outline-primary" type="submit">Търси</button>
                </form>

                <div id="searchResults" class="d-grid gap-2 small"></div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h4 class="mb-0">Текуща количка</h4>
                    <button id="clearCartButton" class="btn btn-outline-secondary btn-sm" type="button">Изчисти</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Артикул</th>
                                <th>Размер</th>
                                <th style="width:150px;">Количество</th>
                                <th>Ед. цена</th>
                                <th style="width:120px;">Отстъпка</th>
                                <th>Общо</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody id="cartBody"></tbody>
                    </table>
                </div>

                <div id="emptyCart" class="alert alert-info">Количката е празна.</div>

                <div class="row justify-content-end">
                    <div class="col-md-5">
                        <div class="border rounded p-3 bg-light">
                            <div class="d-flex justify-content-between">
                                <span>Междинна сума</span>
                                <strong id="subtotal">0.00 EUR</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Отстъпки</span>
                                <strong id="discountTotal">0.00 EUR</strong>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between fs-4">
                                <span>Общо</span>
                                <strong id="grandTotal">0.00 EUR</strong>
                            </div>

                            <label class="form-label mt-3" for="paymentMethod">Начин на плащане</label>
                            <select id="paymentMethod" class="form-select form-select-lg">
                                @foreach (var method in Model.PaymentMethods)
                                {
                                    var member = typeof(PaymentMethod).GetMember(method.ToString())[0];
                                    var descriptionAttribute = member.GetCustomAttributes(typeof(DescriptionAttribute), false).FirstOrDefault() as DescriptionAttribute;
                                    var description = descriptionAttribute?.Description ?? method.ToString();
                                    <option value="@method" selected="@(Model.Cart.PaymentMethod == method)">@description</option>
                                }
                            </select>

                            <button id="checkoutButton" class="btn btn-success btn-lg w-100 mt-3" type="button">Завърши продажба</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var cart = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Cart));
        var highlightedProductInventoryId = null;

        $(document).ready(function () {
            renderCart();
            focusBarcode();

            $('#scanForm').on('submit', function (event) {
                event.preventDefault();
                scanBarcode();
            });

            $('#searchForm').on('submit', function (event) {
                event.preventDefault();
                searchProducts();
            });

            $('#clearCartButton').on('click', function () {
                postJson('/Pos/Clear', {}, function (response) {
                    cart = response.cart;
                    highlightedProductInventoryId = null;
                    renderCart();
                    showMessage('Количката е изчистена.', 'info');
                    focusBarcode();
                });
            });

            $('#checkoutButton').on('click', function () {
                postJson('/Pos/Checkout', { paymentMethod: $('#paymentMethod').val() }, function (response) {
                    window.location.href = response.redirectUrl;
                });
            });
        });

        function scanBarcode() {
            var barcode = $('#barcodeInput').val().trim();
            if (!barcode) {
                focusBarcode();
                return;
            }

            postJson('/Pos/Scan', { barcode: barcode }, function (response) {
                cart = response.cart;
                highlightedProductInventoryId = response.productInventoryId;
                renderCart();
                showMessage(response.message || 'Артикулът е добавен.', 'success');
                $('#barcodeInput').val('');
                focusBarcode();
            }, function () {
                $('#barcodeInput').focus().select();
            });
        }

        function searchProducts() {
            var search = $('#searchInput').val().trim();
            $('#searchResults').empty();

            if (!search) {
                $('#searchResults').append('<div class="alert alert-info mb-0">Въведете SKU, описание или размер.</div>');
                return;
            }

            $('#searchButton').prop('disabled', true).text('Търсене...');
            $('#searchResults').append('<div class="alert alert-secondary mb-0">Търсене...</div>');

            $.get('/Pos/Search', { search: search }, function (results) {
                $('#searchResults').empty();
                if (!results.length) {
                    $('#searchResults').append('<div class="alert alert-info mb-0">Няма намерени артикули.</div>');
                    return;
                }

                $.each(results, function (_, item) {
                    var row = $('<div class="border rounded p-2 bg-light">');
                    row.html('<div class="d-flex justify-content-between gap-2">' +
                        '<div><strong>' + escapeHtml(item.productSKU) + '</strong> - ' + escapeHtml(item.productDescription || '') +
                        '<br />Размер: ' + escapeHtml(item.size) +
                        '<br />Наличност: ' + item.availableStock + ' бр.' +
                        '<br />Цена: ' + money(item.unitPrice) +
                        (item.barcode ? '<br /><span class="text-muted">Баркод: ' + escapeHtml(item.barcode) + '</span>' : '') +
                        '</div><div><button type="button" class="btn btn-success add-result">Добави</button></div></div>');
                    row.find('.add-result').on('click', function () {
                        addLine(item.productInventoryId);
                    });
                    $('#searchResults').append(row);
                });
            }).fail(function () {
                $('#searchResults').empty().append('<div class="alert alert-danger mb-0">Възникна грешка при търсенето. Опитайте отново.</div>');
            }).always(function () {
                $('#searchButton').prop('disabled', false).text('Търси');
            });
        }

        function addLine(productInventoryId) {
            postJson('/Pos/Add', { productInventoryId: productInventoryId, quantity: 1 }, function (response) {
                cart = response.cart;
                highlightedProductInventoryId = response.productInventoryId;
                renderCart();
                showMessage(response.message || 'Артикулът е добавен.', 'success');
                focusBarcode();
            }, focusBarcode);
        }

        function updateQuantity(productInventoryId, quantity) {
            postJson('/Pos/UpdateQuantity', { productInventoryId: productInventoryId, quantity: quantity }, function (response) {
                cart = response.cart;
                highlightedProductInventoryId = response.productInventoryId;
                renderCart();
                focusBarcode();
            }, focusBarcode);
        }

        function updateDiscount(productInventoryId, discountPercent) {
            postJson('/Pos/UpdateDiscount', { productInventoryId: productInventoryId, discountPercent: discountPercent }, function (response) {
                cart = response.cart;
                renderCart();
                focusBarcode();
            }, focusBarcode);
        }

        function removeLine(productInventoryId) {
            postJson('/Pos/Remove', { productInventoryId: productInventoryId }, function (response) {
                cart = response.cart;
                highlightedProductInventoryId = null;
                renderCart();
                showMessage('Редът е премахнат.', 'info');
                focusBarcode();
            });
        }

        function postJson(url, data, onSuccess, onFailure) {
            $.ajax({
                url: url,
                type: 'POST',
                data: data,
                headers: {
                    RequestVerificationToken: $('input[name="__RequestVerificationToken"]').first().val()
                },
                success: function (response) {
                    if (response.success) {
                        onSuccess(response);
                    } else {
                        showMessage(response.message || 'Операцията не беше изпълнена.', response.messageType || 'danger');
                        if (onFailure) {
                            onFailure(response);
                        }
                    }
                },
                error: function () {
                    showMessage('Възникна техническа грешка. Опитайте отново.', 'danger');
                    if (onFailure) {
                        onFailure();
                    }
                }
            });
        }

        function showMessage(text, type) {
            $('#posMessage')
                .removeClass('d-none alert-success alert-info alert-warning alert-danger')
                .addClass('alert-' + type)
                .text(text);
        }

        function renderCart() {
            $('#cartBody').empty();
            var lines = cart.lines || cart.Lines || [];
            $('#emptyCart').toggle(lines.length === 0);
            $('#checkoutButton').prop('disabled', lines.length === 0);

            $.each(lines, function (_, line) {
                var id = value(line.productInventoryId, line.ProductInventoryId);
                var quantity = value(line.quantity, line.Quantity);
                var row = $('<tr>');
                row.attr('data-product-inventory-id', id);
                if (highlightedProductInventoryId && id === highlightedProductInventoryId) {
                    row.addClass('table-success');
                }

                row.append('<td><strong>' + escapeHtml(value(line.productSKU, line.ProductSKU)) + '</strong><br />' + escapeHtml(value(line.productDescription, line.ProductDescription) || '') + '</td>');
                row.append('<td>' + escapeHtml(value(line.size, line.Size)) + '</td>');
                row.append('<td><div class="input-group"><button class="btn btn-outline-secondary minus" type="button">-</button><input class="form-control text-center qty" type="number" min="1" value="' + quantity + '"><button class="btn btn-outline-secondary plus" type="button">+</button></div><small class="text-muted">Наличност ' + value(line.availableStock, line.AvailableStock) + ' бр.</small></td>');
                row.append('<td>' + money(value(line.unitPrice, line.UnitPrice)) + '</td>');
                row.append('<td><input class="form-control discount" type="number" min="0" max="100" value="' + value(line.discountPercent, line.DiscountPercent) + '"></td>');
                row.append('<td>' + money(value(line.lineTotal, line.LineTotal)) + '</td>');
                row.append('<td><button class="btn btn-sm btn-outline-danger remove" type="button">Премахни</button></td>');

                row.find('.minus').on('click', function () { updateQuantity(id, quantity - 1); });
                row.find('.plus').on('click', function () { updateQuantity(id, quantity + 1); });
                row.find('.qty').on('change', function () { updateQuantity(id, parseInt($(this).val())); });
                row.find('.discount').on('change', function () { updateDiscount(id, parseFloat($(this).val())); });
                row.find('.remove').on('click', function () { removeLine(id); });

                $('#cartBody').append(row);
            });

            $('#subtotal').text(money(value(cart.subtotal, cart.Subtotal)));
            $('#discountTotal').text(money(value(cart.discountTotal, cart.DiscountTotal)));
            $('#grandTotal').text(money(value(cart.total, cart.Total)));

            if (highlightedProductInventoryId) {
                window.setTimeout(function () {
                    $('tr[data-product-inventory-id="' + highlightedProductInventoryId + '"]').removeClass('table-success');
                }, 900);
            }
        }

        function focusBarcode() {
            window.setTimeout(function () {
                $('#barcodeInput').focus();
            }, 0);
        }

        function value(camel, pascal) {
            return camel !== undefined ? camel : pascal;
        }

        function money(value) {
            return (parseFloat(value || 0)).toFixed(2) + ' EUR';
        }

        function escapeHtml(value) {
            return $('<div>').text(value || '').html();
        }
    </script>
}
