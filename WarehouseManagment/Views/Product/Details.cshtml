@model ProductModel

@{
    ViewData["Title"] = $"Артикул {Model.SKU}";
    var isAdministrator = User.IsInRole(ApplicationRoles.Administrator);
}

<div class="app-page-header">
    <div>
        <h1>@Model.SKU</h1>
        <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Артикул без описание" : Model.Description)</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Product" asp-action="Index">Назад</a>
        @if (isAdministrator)
        {
            <a class="btn btn-outline-primary" asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id">Редакция</a>
        }
        <a class="btn btn-primary" asp-controller="Product" asp-action="Availability" asp-route-id="@Model.Id">Наличност / варианти</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mb-3">
        <div class="app-card h-100">
            <h5 class="mb-3">Основни данни</h5>
            <dl class="row mb-0">
                <dt class="col-sm-4">SKU</dt>
                <dd class="col-sm-8">@Model.SKU</dd>

                <dt class="col-sm-4">Описание</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>

                <dt class="col-sm-4">Категория</dt>
                <dd class="col-sm-8">@(Model.Category?.ToString() ?? "-")</dd>

                <dt class="col-sm-4">Пол</dt>
                <dd class="col-sm-8">@(Model.Genre?.ToString() ?? "-")</dd>

                <dt class="col-sm-4">Цвят</dt>
                <dd class="col-sm-8">@Model.Color</dd>

                <dt class="col-sm-4">Състав 1</dt>
                <dd class="col-sm-8">@(Model.FirstComposition?.ToString() ?? "-")</dd>

                <dt class="col-sm-4">Състав 2</dt>
                <dd class="col-sm-8">@(Model.SecondComposition?.ToString() ?? "-")</dd>
            </dl>
        </div>
    </div>
    <div class="col-lg-4 mb-3">
        <div class="app-card h-100">
            <h5 class="mb-3">Търговски данни</h5>
            <dl class="row mb-0">
                <dt class="col-6">Цена дребно</dt>
                <dd class="col-6 text-end">@(Model.RetailPrice.HasValue ? Model.RetailPrice.Value.ToString("N2") : "-")</dd>

                <dt class="col-6">Цена едро</dt>
                <dd class="col-6 text-end">@(Model.WholesalePrice.HasValue ? Model.WholesalePrice.Value.ToString("N2") : "-")</dd>

                <dt class="col-6">Обща наличност</dt>
                <dd class="col-6 text-end">@Model.TotalQuantity бр</dd>
            </dl>
        </div>
    </div>
</div>
