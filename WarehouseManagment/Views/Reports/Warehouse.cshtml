@model ReportsIndexModel<WarehouseStockReportRowModel>
@{ ViewData["Title"] = "Складова справка"; }
<div class="app-page-header"><div><h1>Складова справка</h1><p>Наличности по материали. Минимумът се сравнява с основния склад за материали.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" asp-action="WarehouseMovements">Движения</a><a class="btn btn-outline-success" asp-action="Export" asp-route-report="warehouse" asp-route-Search="@Model.Filter.Search">Excel</a></div></div>
<form method="get" class="app-filter-panel row g-2 align-items-end"><div class="col-md-4"><label class="form-label">Материал</label><input name="Search" value="@Model.Filter.Search" class="form-control" /></div><div class="col-md-2"><button class="btn btn-primary w-100">Филтър</button></div></form>
<div class="app-card"><table class="table app-table"><thead><tr><th>Код</th><th>Материал</th><th>Категория</th><th class="text-end">Основен склад</th><th class="text-end">НЗП</th><th class="text-end">Минимум</th><th>Статус</th></tr></thead><tbody>
@foreach (var row in Model.Rows){<tr><td>@row.MaterialCode</td><td>@row.MaterialName</td><td>@row.Category</td><td class="text-end">@QuantityDisplayFormatter.Format(row.DefaultWarehouseQuantity, row.Unit, true)</td><td class="text-end">@QuantityDisplayFormatter.Format(row.WipQuantity, row.Unit, true)</td><td class="text-end">@QuantityDisplayFormatter.Format(row.MinimumStock, row.Unit, true)</td><td><span class="badge @(row.Status == "OK" ? "bg-success" : row.Status == "Под минимум" ? "bg-warning text-dark" : "bg-danger")">@row.Status</span></td></tr>}
</tbody></table></div>
