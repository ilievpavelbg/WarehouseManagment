@model AuditLogDetailsModel

@{
    ViewData["Title"] = "Детайли одит лог";
    var canViewTechnicalDetails = User.IsInRole(ApplicationRoles.Administrator) || User.IsInRole(ApplicationRoles.WarehouseManager);
}

<h1 class="text-center">@ViewData["Title"]</h1>

<div class="alert alert-info">
    Достъпът до този екран е ограничен до Administrator / WarehouseManager.
</div>

<div class="card mb-3">
    <div class="card-header">Основна информация</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Дата</dt><dd class="col-sm-9">@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm:ss")</dd>
            <dt class="col-sm-3">Потребител</dt><dd class="col-sm-9">@Model.UserName</dd>
            <dt class="col-sm-3">Действие</dt><dd class="col-sm-9">@Model.ActionTypeName</dd>
            <dt class="col-sm-3">Обект</dt><dd class="col-sm-9">@Model.EntityTypeName</dd>
            <dt class="col-sm-3">Документ</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.DocumentNumber))
                {
                    <span>-</span>
                }
                else if (Model.HasProductionDocument)
                {
                    <a asp-controller="ProductionDocuments" asp-action="ViewDocument" asp-route-documentNumber="@Model.DocumentNumber">@Model.DocumentNumber</a>
                }
                else
                {
                    @Model.DocumentNumber
                }
            </dd>
            <dt class="col-sm-3">Описание</dt><dd class="col-sm-9">@Model.Description</dd>
            <dt class="col-sm-3">IP адрес</dt><dd class="col-sm-9">@Model.IpAddress</dd>
        </dl>
    </div>
</div>

<div class="mb-3">
    @if (Model.HasProductionDocument)
    {
        <a class="btn btn-outline-primary" asp-controller="ProductionDocuments" asp-action="ViewDocument" asp-route-documentNumber="@Model.DocumentNumber">Отвори документа</a>
    }
    @if (Model.HasProductionOrderLink && int.TryParse(Model.EntityId, out var productionOrderId))
    {
        <a class="btn btn-outline-primary" asp-controller="ProductionOrder" asp-action="Details" asp-route-id="@productionOrderId">Отвори производствената поръчка</a>
    }
    <a class="btn btn-secondary" asp-action="Index">Назад</a>
</div>

@if (Model.OldValueRows.Any() || Model.NewValueRows.Any())
{
    <div class="card mb-3">
        <div class="card-header">Бизнес детайли</div>
        <div class="card-body">
            <div class="row">
                @if (Model.OldValueRows.Any())
                {
                    <div class="col-md-6">
                        <h5>Преди</h5>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                @foreach (var value in Model.OldValueRows)
                                {
                                    <tr>
                                        <th>@value.Label</th>
                                        <td>@value.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (Model.NewValueRows.Any())
                {
                    <div class="col-md-6">
                        <h5>След</h5>
                        <table class="table table-sm table-bordered">
                            <tbody>
                                @foreach (var value in Model.NewValueRows)
                                {
                                    <tr>
                                        <th>@value.Label</th>
                                        <td>@value.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (canViewTechnicalDetails)
{
    <div class="accordion mb-3" id="technicalAuditDetails">
        <div class="accordion-item">
            <h2 class="accordion-header" id="technicalAuditHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#technicalAuditCollapse" aria-expanded="false" aria-controls="technicalAuditCollapse">
                    Технически детайли
                </button>
            </h2>
            <div id="technicalAuditCollapse" class="accordion-collapse collapse" aria-labelledby="technicalAuditHeading" data-bs-parent="#technicalAuditDetails">
                <div class="accordion-body">
                    <dl class="row">
                        <dt class="col-sm-3">EntityId</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.EntityId) ? "-" : Model.EntityId)</dd>
                        <dt class="col-sm-3">UserId</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.UserId) ? "-" : Model.UserId)</dd>
                        <dt class="col-sm-3">Raw ActionType</dt><dd class="col-sm-9">@Model.RawActionType</dd>
                        <dt class="col-sm-3">Raw EntityType</dt><dd class="col-sm-9">@Model.RawEntityType</dd>
                    </dl>

                    @if (!string.IsNullOrWhiteSpace(Model.OldValues))
                    {
                        <h5>Raw OldValues</h5>
                        <pre class="bg-light border p-3">@Model.OldValues</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.NewValues))
                    {
                        <h5>Raw NewValues</h5>
                        <pre class="bg-light border p-3">@Model.NewValues</pre>
                    }
                </div>
            </div>
        </div>
    </div>
}
