@model ProductionWorkTaskIndexModel

@{
    ViewData["Title"] = "Моите задачи";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">@ViewData["Title"]</h1>
        <div class="text-muted">
            @(string.IsNullOrWhiteSpace(Model.UserName) ? "Потребител" : Model.UserName)
            @if (!string.IsNullOrWhiteSpace(Model.RoleDisplayName))
            {
                <span> / @Model.RoleDisplayName</span>
            }
            <span> / @Model.CurrentDate.ToString("dd.MM.yyyy")</span>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="row">
    <div class="col-6 col-lg-3 mb-3">
        <div class="card h-100 border-primary">
            <div class="card-body">
                <div class="text-muted small">Активни задачи</div>
                <div class="fs-3 fw-bold">@Model.ActiveTaskCount</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card h-100 border-info">
            <div class="card-body">
                <div class="text-muted small">Налично за работа</div>
                <div class="fs-3 fw-bold">@QuantityDisplayFormatter.Format(Model.TotalAvailableQuantity, "бр")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card h-100 border-success">
            <div class="card-body">
                <div class="text-muted small">Завършено днес</div>
                <div class="fs-3 fw-bold">@QuantityDisplayFormatter.Format(Model.CompletedToday, "бр")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3 mb-3">
        <div class="card h-100 border-danger">
            <div class="card-body">
                <div class="text-muted small">Брак днес</div>
                <div class="fs-3 fw-bold">@QuantityDisplayFormatter.Format(Model.RejectedToday, "бр")</div>
            </div>
        </div>
    </div>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">Номер на поръчка</label>
        <input asp-for="Filter.OrderNumber" name="OrderNumber" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Операция</label>
        <input asp-for="Filter.Operation" name="Operation" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Планиран край до</label>
        <input asp-for="Filter.PlannedEndDate" name="PlannedEndDate" type="date" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Статус</label>
        <select asp-for="Filter.Status" name="Status" class="form-select">
            <option value="">Всички</option>
            @foreach (ProductionOrderOperationStatus status in Enum.GetValues(typeof(ProductionOrderOperationStatus)))
            {
                <option value="@status" selected="@(Model.Filter.Status == status)">@ProductionOrderDisplayHelper.OperationStatusText(status)</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary me-2">Филтър</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Изчисти</a>
    </div>
</form>

@if (!Model.Rows.Any())
{
    <div class="text-center py-5">
        <h2 class="h4">В момента няма активни производствени задачи.</h2>
        <p class="text-muted mb-0">Новите задачи ще се появят автоматично, когато има налично количество за вашата операция.</p>
    </div>
}
else
{
    <div class="table-responsive production-table-scroll d-none d-lg-block">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Поръчка</th>
                    <th>Артикул</th>
                    <th>Операция</th>
                    <th>Роля</th>
                    <th class="text-end">Планирано</th>
                    <th class="text-end">Налично</th>
                    <th class="text-end">Завършено</th>
                    <th class="text-end">Брак</th>
                    <th>Планиран край</th>
                    <th class="text-center">Статус</th>
                    <th>Действие</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.OrderNumber</td>
                        <td>@row.ProductDisplayName</td>
                        <td>@row.OperationName</td>
                        <td>@ProductionOrderDisplayHelper.RoleText(row.RequiredRole)</td>
                        <td class="text-end">@QuantityDisplayFormatter.Format(row.PlannedQuantity, row.UnitOfMeasure, true)</td>
                        <td class="text-end">@QuantityDisplayFormatter.Format(row.AvailableQuantity, row.UnitOfMeasure, true)</td>
                        <td class="text-end">@QuantityDisplayFormatter.Format(row.CompletedQuantity, row.UnitOfMeasure, true)</td>
                        <td class="text-end">@QuantityDisplayFormatter.Format(row.RejectedQuantity, row.UnitOfMeasure, true)</td>
                        <td>@(row.PlannedEndDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td class="text-center"><span class="badge @ProductionOrderDisplayHelper.OperationStatusCss(row.Status)">@ProductionOrderDisplayHelper.OperationStatusText(row.Status)</span></td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@row.ProductionOrderOperationId">Преглед</a>
                            <a class="btn btn-sm btn-success" asp-action="Report" asp-route-id="@row.ProductionOrderOperationId">Отчети работа</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-lg-none">
        @foreach (var row in Model.Rows)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div>
                            <div class="fw-bold">@row.OrderNumber</div>
                            <div>@row.ProductDisplayName</div>
                            <div class="text-muted">@row.OperationName</div>
                        </div>
                        <span class="badge @ProductionOrderDisplayHelper.OperationStatusCss(row.Status)">@ProductionOrderDisplayHelper.OperationStatusText(row.Status)</span>
                    </div>
                    <div class="row mt-3 small">
                        <div class="col-6 mb-2"><span class="text-muted">Налично</span><br /><strong>@row.AvailableQuantity.ToString("N4") @row.UnitOfMeasure</strong></div>
                        <div class="col-6 mb-2"><span class="text-muted">Завършено</span><br /><strong>@row.CompletedQuantity.ToString("N4") @row.UnitOfMeasure</strong></div>
                        <div class="col-6 mb-2"><span class="text-muted">Брак</span><br /><strong>@row.RejectedQuantity.ToString("N4") @row.UnitOfMeasure</strong></div>
                        <div class="col-6 mb-2"><span class="text-muted">Планиран край</span><br /><strong>@(row.PlannedEndDate?.ToString("dd.MM.yyyy") ?? "-")</strong></div>
                    </div>
                    <div class="d-grid gap-2">
                        <a class="btn btn-success" asp-action="Report" asp-route-id="@row.ProductionOrderOperationId">Отчети работа</a>
                        <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@row.ProductionOrderOperationId">Преглед</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : string.Empty)">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-orderNumber="@Model.Filter.OrderNumber" asp-route-operation="@Model.Filter.Operation" asp-route-plannedEndDate="@Model.Filter.PlannedEndDate?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Filter.Status">Назад</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : string.Empty)">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-orderNumber="@Model.Filter.OrderNumber" asp-route-operation="@Model.Filter.Operation" asp-route-plannedEndDate="@Model.Filter.PlannedEndDate?.ToString("yyyy-MM-dd")" asp-route-status="@Model.Filter.Status">Напред</a>
            </li>
        </ul>
    </nav>
}
