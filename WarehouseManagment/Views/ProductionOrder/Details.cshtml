@model ProductionOrderDetailsModel

@{
    ViewData["Title"] = "Производствена поръчка";
    var materialReadiness = Model.MaterialReadiness;
    var canStart = Model.Status == ProductionOrderStatus.Released && materialReadiness?.IsReady == true && materialReadiness.IsTransferred == false;
    var isReleasedWaitingForMaterials = Model.Status == ProductionOrderStatus.Released && materialReadiness != null && !materialReadiness.IsReady;
    var isAwaitingFinalization = Model.Status == ProductionOrderStatus.ProductionCompleted;
    var shortageCount = materialReadiness?.Rows.Count(x => x.ShortageQuantity > 0) ?? 0;
    var readinessText = materialReadiness == null
        ? "Няма данни за материална готовност"
        : materialReadiness.IsTransferred
            ? "Материалите са прехвърлени"
            : materialReadiness.IsReady
                ? "Готова за стартиране"
                : "Не е готова за стартиране";
    var readinessBadgeClass = materialReadiness == null
        ? "bg-secondary"
        : materialReadiness.IsReady || materialReadiness.IsTransferred
            ? "bg-success"
            : "bg-danger";
}

<h1 class="text-center">@Model.OrderNumber</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (isReleasedWaitingForMaterials)
{
    <div class="alert alert-warning border-warning shadow-sm">
        <h5 class="alert-heading mb-2">Поръчката изчаква материали</h5>
        <p class="mb-0">
            Поръчката е освободена, но не може да бъде стартирана поради недостиг на материали.
            Производството ще може да започне след осигуряване на всички необходими материали.
        </p>
    </div>
}

@if (isAwaitingFinalization)
{
    <div class="alert alert-info border-info shadow-sm">
        <h5 class="alert-heading mb-2">Производството е отчетено</h5>
        <p class="mb-0">
            Всички производствени операции са приключени. Мениджър трябва да извърши финално приключване,
            за да се отпишат материалите от НЗП и да се приеме готовата продукция в склада.
        </p>
    </div>
}

<div class="mb-3">
    <div class="d-flex justify-content-between">
        <span>Общ прогрес</span>
        <strong>@Model.ProgressPercent.ToString("N2")%</strong>
    </div>
    <div class="progress">
        <div class="progress-bar" role="progressbar" style="width: @Model.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%;" aria-valuenow="@Model.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Производствен процес</div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
            <span class="badge @(Model.Status == ProductionOrderStatus.Planned ? "bg-primary" : "bg-secondary")">Планирана</span>
            <span class="badge @(Model.Status == ProductionOrderStatus.Released ? "bg-primary" : "bg-secondary")">Освободена</span>
            <span class="badge @(Model.Status == ProductionOrderStatus.Released ? readinessBadgeClass : "bg-secondary")">Проверка на материалите</span>
            <span class="badge @(materialReadiness?.IsTransferred == true ? "bg-primary" : "bg-secondary")">Трансфер към НЗП</span>
            <span class="badge @(Model.Status == ProductionOrderStatus.InProgress ? "bg-primary" : "bg-secondary")">Производство</span>
            <span class="badge @(Model.Status == ProductionOrderStatus.ProductionCompleted ? "bg-info" : "bg-secondary")">Очаква приключване</span>
            <span class="badge @(Model.Status == ProductionOrderStatus.Completed ? "bg-success" : "bg-secondary")">Завършена</span>
        </div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Основна информация</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Поръчка</dt><dd class="col-sm-7">@Model.OrderNumber</dd>
                    <dt class="col-sm-5">Артикул</dt><dd class="col-sm-7">@Model.ProductDisplayName</dd>
                    <dt class="col-sm-5">Размер / вариант</dt><dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.ProductVariant) ? "-" : Model.ProductVariant)</dd>
                    <dt class="col-sm-5">Производствено име</dt><dd class="col-sm-7">@Model.ProductionName</dd>
                    <dt class="col-sm-5">Планирано количество</dt><dd class="col-sm-7">@Model.PlannedQuantity.ToString("N4") @Model.UnitOfMeasure</dd>
                    <dt class="col-sm-5">Приоритет</dt><dd class="col-sm-7">@ProductionOrderDisplayHelper.PriorityText(Model.Priority)</dd>
                    <dt class="col-sm-5">Статус</dt><dd class="col-sm-7"><span class="badge @ProductionOrderDisplayHelper.StatusCss(Model.Status)">@ProductionOrderDisplayHelper.StatusText(Model.Status)</span></dd>
                    <dt class="col-sm-5">Прогрес</dt><dd class="col-sm-7">@Model.ProgressPercent.ToString("N2")%</dd>
                    <dt class="col-sm-5">Бележки</dt><dd class="col-sm-7">@(Model.Notes ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Използвани версии</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Разходна норма</dt><dd class="col-sm-7">Версия @Model.BillOfMaterialsVersion</dd>
                    <dt class="col-sm-5">Технологичен маршрут</dt><dd class="col-sm-7">Версия @Model.ProductRoutingVersion</dd>
                    <dt class="col-sm-5">Калкулация</dt><dd class="col-sm-7">@Model.CostCalculationText</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Складове</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Склад производство / НЗП</dt><dd class="col-sm-7">@Model.WipWarehouse</dd>
                    <dt class="col-sm-5">Склад готова продукция</dt><dd class="col-sm-7">@Model.FinishedGoodsWarehouse</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">История</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Планиран старт</dt><dd class="col-sm-7">@(Model.PlannedStartDate?.ToString("dd.MM.yyyy") ?? "-")</dd>
                    <dt class="col-sm-5">Планиран край</dt><dd class="col-sm-7">@(Model.PlannedEndDate?.ToString("dd.MM.yyyy") ?? "-")</dd>
                    <dt class="col-sm-5">Реален старт</dt><dd class="col-sm-7">@(Model.ActualStartDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-sm-5">Реален край</dt><dd class="col-sm-7">@(Model.ActualEndDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-sm-5">Създадена</dt><dd class="col-sm-7">@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</dd>
                    <dt class="col-sm-5">Създал</dt><dd class="col-sm-7">@(Model.CreatedByUserId ?? "-")</dd>
                    <dt class="col-sm-5">Стартирал</dt><dd class="col-sm-7">@(Model.StartedByUserId ?? "-")</dd>
                    <dt class="col-sm-5">Приключил</dt><dd class="col-sm-7">@(Model.CompletedByUserId ?? "-")</dd>
                    @if (Model.ProductionFinalizedOn.HasValue)
                    {
                        <dt class="col-sm-5">Финално приключена</dt><dd class="col-sm-7">@Model.ProductionFinalizedOn.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                        <dt class="col-sm-5">Приключил финално</dt><dd class="col-sm-7">@(Model.ProductionFinalizedByUserId ?? "-")</dd>
                        <dt class="col-sm-5">PMC документ</dt><dd class="col-sm-7">@(Model.MaterialConsumptionDocumentNumber ?? "-")</dd>
                        <dt class="col-sm-5">FGR документ</dt><dd class="col-sm-7">@(Model.FinishedGoodsReceiptDocumentNumber ?? "-")</dd>
                    }
                    @if (Model.Status == ProductionOrderStatus.Cancelled)
                    {
                        <dt class="col-sm-5">Отменена на</dt><dd class="col-sm-7">@(Model.CancelledOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                        <dt class="col-sm-5">Отменил</dt><dd class="col-sm-7">@(Model.CancelledByUserId ?? "-")</dd>
                        <dt class="col-sm-5">Причина</dt><dd class="col-sm-7">@Model.CancellationReason</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Материали за производство</span>
        <span class="badge @readinessBadgeClass">@readinessText</span>
    </div>
    <div class="card-body">
        @if (materialReadiness == null)
        {
            <div class="alert alert-info mb-0">Няма информация за материална готовност.</div>
        }
        else
        {
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Източник:</strong> @(materialReadiness.SourceWarehouse ?? "Основен склад за материали не е зададен")
                </div>
                <div class="col-md-6">
                    <strong>Дестинация:</strong> @(materialReadiness.DestinationWarehouse ?? "Склад производство / НЗП не е зададен")
                </div>
            </div>

            @if (materialReadiness.Rows.Any())
            {
                if (shortageCount > 0)
                {
                    <div class="alert alert-danger">
                        <strong>Липсват @shortageCount материала.</strong><br />
                        Производството не може да бъде стартирано.
                    </div>
                }
                else if (!materialReadiness.IsTransferred)
                {
                    <div class="alert alert-success">
                        <strong>Всички материали са налични.</strong><br />
                        Производството може да бъде стартирано.
                    </div>
                }
            }

            <div class="alert @(materialReadiness.IsReady ? "alert-success" : "alert-warning")">@materialReadiness.Message</div>

            @if (materialReadiness.IsTransferred)
            {
                <dl class="row">
                    <dt class="col-sm-3">PMT документ</dt><dd class="col-sm-9">@(materialReadiness.TransferDocumentNumber ?? "-")</dd>
                    <dt class="col-sm-3">Дата на прехвърляне</dt><dd class="col-sm-9">@(materialReadiness.TransferredOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                    <dt class="col-sm-3">Потребител</dt><dd class="col-sm-9">@(materialReadiness.TransferredByUserId ?? "-")</dd>
                </dl>
            }

            @if (materialReadiness.CanGenerateSnapshot)
            {
                <form asp-action="GenerateMaterialSnapshot" asp-route-id="@Model.Id" method="post" class="mb-3">
                    <button type="submit" class="btn btn-outline-primary" onclick="return confirm('Да генерирам ли материалните изисквания по замразената разходна норма на поръчката?');">Генерирай материални изисквания</button>
                </form>
            }

            @if (materialReadiness.Rows.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped table-bordered align-middle">
                        <thead>
                            <tr>
                                <th>Материал</th>
                                <th class="text-end">Нужно</th>
                                <th class="text-end">Налично</th>
                                <th class="text-end">Недостиг</th>
                                <th>Мерна единица</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in materialReadiness.Rows)
                            {
                                var hasShortage = row.ShortageQuantity > 0;
                                <tr class="@(hasShortage ? "table-warning" : string.Empty)">
                                    <td>
                                        <strong>@row.MaterialCode</strong><br />
                                        <span>@row.MaterialName</span>
                                    </td>
                                    <td class="text-end">@row.OutstandingQuantity.ToString("N4")</td>
                                    <td class="text-end">@row.AvailableQuantity.ToString("N4")</td>
                                    <td class="text-end @(hasShortage ? "text-danger fw-bold" : string.Empty)">@row.ShortageQuantity.ToString("N4")</td>
                                    <td>@row.Unit</td>
                                    <td><span class="badge @(hasShortage ? "bg-danger" : "bg-success")">@row.StatusText</span></td>
                                </tr>
                                @if (row.Allocations.Any())
                                {
                                    <tr>
                                        <td colspan="6">
                                            <details>
                                                <summary>Разпределения по партиди и локации</summary>
                                                <table class="table table-sm table-bordered mt-2 mb-0">
                                                    <thead>
                                                        <tr>
                                                            <th>Източник</th>
                                                            <th>Локация</th>
                                                            <th>Дестинация</th>
                                                            <th>Партида</th>
                                                            <th>Lot</th>
                                                            <th class="text-end">Количество</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var allocation in row.Allocations)
                                                        {
                                                            <tr>
                                                                <td>@allocation.SourceWarehouse</td>
                                                                <td>@allocation.SourceLocation</td>
                                                                <td>@allocation.DestinationWarehouse</td>
                                                                <td>@(allocation.BatchNumber ?? "-")</td>
                                                                <td>@(allocation.LotNumber ?? "-")</td>
                                                                <td class="text-end">@allocation.Quantity.ToString("N4")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </details>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@if (Model.MaterialCompletionRows.Any())
{
    <div class="card mb-3">
        <div class="card-header">Материално приключване</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-striped table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Материал</th>
                            <th class="text-end">Нужно</th>
                            <th class="text-end">Прехвърлено</th>
                            <th class="text-end">Потребено</th>
                            <th class="text-end">Върнато</th>
                            <th class="text-end">Остава в НЗП</th>
                            <th>Мерна единица</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.MaterialCompletionRows)
                        {
                            <tr>
                                <td>@row.MaterialDisplayName</td>
                                <td class="text-end">@row.RequiredQuantity.ToString("N4")</td>
                                <td class="text-end">@row.TransferredQuantity.ToString("N4")</td>
                                <td class="text-end">@row.ConsumedQuantity.ToString("N4")</td>
                                <td class="text-end">@row.ReturnedQuantity.ToString("N4")</td>
                                <td class="text-end">@row.RemainingInWip.ToString("N4")</td>
                                <td>@row.Unit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (Model.FinishedGoodsReceipt != null)
{
    <div class="card mb-3">
        <div class="card-header">Приета готова продукция</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Документ</dt><dd class="col-sm-9">@Model.FinishedGoodsReceipt.DocumentNumber</dd>
                <dt class="col-sm-3">Артикул</dt><dd class="col-sm-9">@Model.FinishedGoodsReceipt.ProductDisplayName</dd>
                <dt class="col-sm-3">Размер / вариант</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.FinishedGoodsReceipt.Size) ? "-" : Model.FinishedGoodsReceipt.Size)</dd>
                <dt class="col-sm-3">Количество</dt><dd class="col-sm-9">@Model.FinishedGoodsReceipt.Quantity</dd>
                <dt class="col-sm-3">Склад</dt><dd class="col-sm-9">@Model.FinishedGoodsReceipt.Warehouse</dd>
                <dt class="col-sm-3">Дата</dt><dd class="col-sm-9">@Model.FinishedGoodsReceipt.CreatedOn.ToString("dd.MM.yyyy HH:mm")</dd>
                <dt class="col-sm-3">Потребител</dt><dd class="col-sm-9">@(Model.FinishedGoodsReceipt.CreatedByUserId ?? "-")</dd>
            </dl>
        </div>
    </div>
}

<h5>Производствени операции</h5>
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Последователност</th>
                <th>Операция</th>
                <th>Роля</th>
                <th>План</th>
                <th>Налични</th>
                <th>Завършени</th>
                <th>Брак</th>
                <th>Статус</th>
                <th>Прогрес</th>
                <th>Последен отчет</th>
                <th>Последен работник</th>
                <th>Стандартно време</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var operation in Model.Operations)
            {
                <tr>
                    <td>@operation.Sequence</td>
                    <td>@operation.OperationName</td>
                    <td>@operation.RequiredRole</td>
                    <td>@operation.PlannedQuantity.ToString("N4")</td>
                    <td>@operation.AvailableQuantity.ToString("N4")</td>
                    <td>@operation.CompletedQuantity.ToString("N4")</td>
                    <td>@operation.RejectedQuantity.ToString("N4")</td>
                    <td><span class="badge @ProductionOrderDisplayHelper.OperationStatusCss(operation.Status)">@ProductionOrderDisplayHelper.OperationStatusText(operation.Status)</span></td>
                    <td style="min-width: 160px;">
                        <div class="progress">
                            <div class="progress-bar" role="progressbar" style="width: @operation.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)%;" aria-valuenow="@operation.ProgressPercent.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100">
                                @operation.ProgressPercent.ToString("N0")%
                            </div>
                        </div>
                        @if (operation.Status == ProductionOrderOperationStatus.Ready || operation.Status == ProductionOrderOperationStatus.InProgress)
                        {
                            <span class="badge bg-warning text-dark mt-1">Активна операция</span>
                        }
                    </td>
                    <td>@(operation.LastReportDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                    <td>@(operation.LastReportingWorker ?? "-")</td>
                    <td>@(operation.StandardTimeMinutes?.ToString() ?? "-")</td>
                    <td>
                        @if (operation.AvailableQuantity > 0 && (operation.Status == ProductionOrderOperationStatus.Ready || operation.Status == ProductionOrderOperationStatus.InProgress))
                        {
                            <a class="btn btn-sm btn-outline-success" asp-controller="ProductionWork" asp-action="Report" asp-route-id="@operation.Id">Отчет</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h5>История на отчетена работа</h5>
@if (!Model.Operations.Any(x => x.WorkHistory.Any()))
{
    <div class="alert alert-info">Няма отчетена работа по тази производствена поръчка.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Дата/час</th>
                    <th>Операция</th>
                    <th>Работник</th>
                    <th>Завършено</th>
                    <th>Брак</th>
                    <th>Начало</th>
                    <th>Край</th>
                    <th>Бележки</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var operation in Model.Operations)
                {
                    foreach (var entry in operation.WorkHistory)
                    {
                        <tr>
                            <td>@entry.CreatedOn.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@operation.OperationName</td>
                            <td>@(string.IsNullOrWhiteSpace(entry.Worker) ? "-" : entry.Worker)</td>
                            <td>@entry.ReportedCompletedQuantity.ToString("N4")</td>
                            <td>@entry.ReportedRejectedQuantity.ToString("N4")</td>
                            <td>@(entry.WorkStartedOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            <td>@(entry.WorkEndedOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            <td>@(entry.Notes ?? "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

<div class="mb-3">
    @if (Model.Status == ProductionOrderStatus.Planned)
    {
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Редакция</a>
        <form asp-action="Release" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-primary" onclick="return confirm('Да освободя ли поръчката за производство?');">Освободи</button>
        </form>
        <a class="btn btn-outline-danger" asp-action="Cancel" asp-route-id="@Model.Id">Отмени</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Изтриването е необратимо. Сигурни ли сте?');">Изтрий</button>
        </form>
    }
    @if (Model.Status == ProductionOrderStatus.Released)
    {
        <form asp-action="Start" asp-route-id="@Model.Id" method="post" class="d-inline">
            <span title="@(canStart ? string.Empty : "Липсват необходими материали")" data-bs-toggle="tooltip">
                <button type="submit" class="btn btn-outline-success" disabled="@(!canStart)" onclick="return confirm('Да стартирам ли производствената поръчка и да прехвърля материалите към НЗП?');">Стартирай</button>
            </span>
        </form>
        <a class="btn btn-outline-danger" asp-action="Cancel" asp-route-id="@Model.Id">Отмени</a>
    }
    @if (Model.Status == ProductionOrderStatus.InProgress)
    {
        <a class="btn btn-outline-danger" asp-action="Cancel" asp-route-id="@Model.Id">Отмени</a>
    }
    @if (Model.Status == ProductionOrderStatus.ProductionCompleted)
    {
        <a class="btn btn-outline-success" asp-action="Finalize" asp-route-id="@Model.Id">Финално приключване</a>
    }
    <a class="btn btn-secondary" asp-action="Index">Назад</a>
</div>
