@model ProductionOrderDetailsModel

@{
    ViewData["Title"] = "Производствена поръчка";
}

<h1 class="text-center">@Model.OrderNumber</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="alert alert-info">
    Отчитане от работници, складови движения и автоматични количества ще бъдат активирани в следващите етапи.
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <h5>Основни данни</h5>
        <dl class="row">
            <dt class="col-sm-4">Артикул</dt><dd class="col-sm-8">@Model.ProductDisplayName</dd>
            <dt class="col-sm-4">Производствено име</dt><dd class="col-sm-8">@Model.ProductionName</dd>
            <dt class="col-sm-4">Количество</dt><dd class="col-sm-8">@Model.PlannedQuantity.ToString("N4") @Model.UnitOfMeasure</dd>
            <dt class="col-sm-4">Статус</dt><dd class="col-sm-8">@StatusText(Model.Status)</dd>
            <dt class="col-sm-4">Прогрес</dt><dd class="col-sm-8">@Model.ProgressPercent.ToString("N2")%</dd>
            <dt class="col-sm-4">Приоритет</dt><dd class="col-sm-8">@PriorityText(Model.Priority)</dd>
            <dt class="col-sm-4">Планиран старт</dt><dd class="col-sm-8">@(Model.PlannedStartDate?.ToString("dd.MM.yyyy") ?? "-")</dd>
            <dt class="col-sm-4">Планиран край</dt><dd class="col-sm-8">@(Model.PlannedEndDate?.ToString("dd.MM.yyyy") ?? "-")</dd>
            <dt class="col-sm-4">Създадена</dt><dd class="col-sm-8">@Model.CreatedOn.ToString("dd.MM.yyyy HH:mm")</dd>
            <dt class="col-sm-4">Бележки</dt><dd class="col-sm-8">@(Model.Notes ?? "-")</dd>
        </dl>
    </div>
    <div class="col-md-6">
        <h5>Фиксирана настройка</h5>
        <dl class="row">
            <dt class="col-sm-5">Разходна норма</dt><dd class="col-sm-7">Версия @Model.BillOfMaterialsVersion</dd>
            <dt class="col-sm-5">Маршрут</dt><dd class="col-sm-7">Версия @Model.ProductRoutingVersion</dd>
            <dt class="col-sm-5">Калкулация</dt><dd class="col-sm-7">@Model.CostCalculationText</dd>
            <dt class="col-sm-5">Склад производство / НЗП</dt><dd class="col-sm-7">@Model.WipWarehouse</dd>
            <dt class="col-sm-5">Склад готова продукция</dt><dd class="col-sm-7">@Model.FinishedGoodsWarehouse</dd>
            @if (Model.Status == ProductionOrderStatus.Cancelled)
            {
                <dt class="col-sm-5">Анулирана на</dt><dd class="col-sm-7">@(Model.CancelledOn?.ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                <dt class="col-sm-5">Причина</dt><dd class="col-sm-7">@Model.CancellationReason</dd>
            }
        </dl>
    </div>
</div>

<h5>Операции</h5>
<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Последователност</th>
            <th>Операция</th>
            <th>Роля</th>
            <th>Планирано</th>
            <th>Налично</th>
            <th>Завършено</th>
            <th>Брак</th>
            <th>Статус</th>
            <th>Стандартно време</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var operation in Model.Operations)
        {
            <tr>
                <td>@operation.Sequence</td>
                <td>@operation.OperationName</td>
                <td>@operation.RequiredRole</td>
                <td>@operation.PlannedQuantity.ToString("N4")</td>
                <td>@operation.AvailableQuantity.ToString("N4")</td>
                <td>@operation.CompletedQuantity.ToString("N4")</td>
                <td>@operation.RejectedQuantity.ToString("N4")</td>
                <td>@OperationStatusText(operation.Status)</td>
                <td>@(operation.StandardTimeMinutes?.ToString() ?? "-")</td>
            </tr>
        }
    </tbody>
</table>

<div class="mb-3">
    @if (Model.Status == ProductionOrderStatus.Planned)
    {
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Редакция</a>
        <form asp-action="Release" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-primary">Освободи</button>
        </form>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-danger">Изтрий</button>
        </form>
    }
    @if (Model.Status == ProductionOrderStatus.Released)
    {
        <form asp-action="Start" asp-route-id="@Model.Id" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-success">Стартирай</button>
        </form>
    }
    @if (Model.Status == ProductionOrderStatus.Planned || Model.Status == ProductionOrderStatus.Released || Model.Status == ProductionOrderStatus.InProgress)
    {
        <form asp-action="Cancel" method="post" class="d-inline-flex gap-2 align-items-center">
            <input type="hidden" name="Id" value="@Model.Id" />
            <input name="CancellationReason" class="form-control form-control-sm" placeholder="Причина за анулиране" />
            <button type="submit" class="btn btn-outline-danger">Анулирай</button>
        </form>
    }
    <a class="btn btn-secondary" asp-action="Index">Назад</a>
</div>

@functions {
    private static string StatusText(ProductionOrderStatus status)
    {
        return status switch
        {
            ProductionOrderStatus.Draft => "Чернова",
            ProductionOrderStatus.Planned => "Планирана",
            ProductionOrderStatus.Released => "Освободена",
            ProductionOrderStatus.InProgress => "В производство",
            ProductionOrderStatus.Paused => "Пауза",
            ProductionOrderStatus.Completed => "Завършена",
            ProductionOrderStatus.Cancelled => "Анулирана",
            _ => status.ToString()
        };
    }

    private static string OperationStatusText(ProductionOrderOperationStatus status)
    {
        return status switch
        {
            ProductionOrderOperationStatus.Locked => "Заключена",
            ProductionOrderOperationStatus.Pending => "Изчаква",
            ProductionOrderOperationStatus.Ready => "Готова",
            ProductionOrderOperationStatus.InProgress => "В процес",
            ProductionOrderOperationStatus.Completed => "Завършена",
            ProductionOrderOperationStatus.Cancelled => "Анулирана",
            _ => status.ToString()
        };
    }

    private static string PriorityText(ProductionOrderPriority priority)
    {
        return priority switch
        {
            ProductionOrderPriority.Low => "Нисък",
            ProductionOrderPriority.Normal => "Нормален",
            ProductionOrderPriority.High => "Висок",
            ProductionOrderPriority.Urgent => "Спешен",
            _ => priority.ToString()
        };
    }
}
