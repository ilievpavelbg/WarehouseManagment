@model List<CostComponent>

@{
    ViewData["Title"] = "Компоненти себестойност";
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">Нов компонент</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Код</th>
            <th>Име</th>
            <th>Ред</th>
            <th>Пряк разход</th>
            <th>Системно изчислен</th>
            <th>Активен</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var component in Model)
        {
            <tr>
                <td>@component.Code</td>
                <td>@component.Name</td>
                <td>@component.DisplayOrder</td>
                <td>@(component.IsDirectCost ? "Да" : "Не")</td>
                <td>@(component.IsSystemCalculated ? "Да" : "Не")</td>
                <td>@(component.IsActive ? "Да" : "Не")</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@component.Id">Редакция</a>
                    <form asp-action="Delete" asp-route-id="@component.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Изтрий</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
