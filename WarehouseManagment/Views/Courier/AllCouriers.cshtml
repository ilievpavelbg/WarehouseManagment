@model CourierReportIndexModel

@{
    ViewData["Title"] = "Отчет куриерски пратки";
    var filter = Model.Filter;
}

<h1 class="text-center">@ViewData["Title"]</h1>

<form method="get" asp-action="AllCouriers" class="row g-2 align-items-end my-4">
    <div class="col-md-2">
        <label class="form-label">Документ</label>
        <input name="DocumentNumber" value="@filter.DocumentNumber" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Товарителница</label>
        <input name="ShippmentBill" value="@filter.ShippmentBill" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">SKU / артикул</label>
        <input name="ProductSKU" value="@filter.ProductSKU" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Размер</label>
        <select name="Size" class="form-select">
            <option value="">Всички</option>
            @foreach (var size in Model.Sizes)
            {
                <option value="@size" selected="@(filter.Size == size.ToString())">@size</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Куриер</label>
        <select name="CourierName" class="form-select">
            <option value="">Всички</option>
            @foreach (var courierName in Model.CourierNames)
            {
                <option value="@courierName" selected="@(filter.CourierName == courierName)">@courierName</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Дата от</label>
        <input name="DateFrom" type="date" value="@filter.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Дата до</label>
        <input name="DateTo" type="date" value="@filter.DateTo?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Плащане</label>
        <select name="PaymentMethod" class="form-select">
            <option value="">Всички</option>
            @foreach (var method in Model.PaymentMethods)
            {
                <option value="@method" selected="@(filter.PaymentMethod == method)">@method</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Оператор</label>
        <input name="Operator" value="@filter.Operator" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Статус</label>
        <select name="Status" class="form-select">
            <option value="">Всички</option>
            <option value="active" selected="@(filter.Status == "active")">Активни</option>
            <option value="reversed" selected="@(filter.Status == "reversed")">Сторнирани</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-success w-100">Филтрирай</button>
    </div>
    <div class="col-md-2">
        <a asp-action="AllCouriers" class="btn btn-outline-secondary w-100">Изчисти</a>
    </div>
    <div class="col-md-2">
        <a class="btn btn-danger w-100"
           asp-action="ExportToExcel"
           asp-route-DocumentNumber="@filter.DocumentNumber"
           asp-route-ShippmentBill="@filter.ShippmentBill"
           asp-route-ProductSKU="@filter.ProductSKU"
           asp-route-Size="@filter.Size"
           asp-route-CourierName="@filter.CourierName"
           asp-route-DateFrom="@filter.DateFrom?.ToString("yyyy-MM-dd")"
           asp-route-DateTo="@filter.DateTo?.ToString("yyyy-MM-dd")"
           asp-route-PaymentMethod="@filter.PaymentMethod"
           asp-route-Operator="@filter.Operator"
           asp-route-Status="@filter.Status">Експорт Excel</a>
    </div>
</form>

<div class="mb-2 text-muted">Намерени записи: @Model.TotalItems</div>

@if (!Model.Rows.Any())
{
    <div class="alert alert-info">Няма намерени куриерски пратки.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Документ</th>
                    <th>Товарителница</th>
                    <th>SKU</th>
                    <th>Размер</th>
                    <th>Дата</th>
                    <th>Количество</th>
                    <th>Ед. цена</th>
                    <th>Общо</th>
                    <th>Куриер</th>
                    <th>Плащане</th>
                    <th>Оператор</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Rows)
                {
                    <tr>
                        <td>@(item.DocumentNumber ?? "-")</td>
                        <td>@item.ShippmentBill</td>
                        <td>@item.ProductSKU</td>
                        <td>@item.Size</td>
                        <td>@item.SendDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.Quantity бр</td>
                        <td>@item.UnitPrice.ToString("0.00") EUR</td>
                        <td>@item.TotalPrice.ToString("0.00") EUR</td>
                        <td>@item.CourierName</td>
                        <td>@item.CourierPaymentMethod</td>
                        <td>@(item.CreatedByUserNameSnapshot ?? "-")</td>
                        <td>
                            @if (item.IsDeleted)
                            {
                                <span class="badge bg-danger">Сторнирана</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Активна</span>
                            }
                        </td>
                        <td>
                            @if (!item.IsDeleted)
                            {
                                <a class="btn btn-sm btn-success" asp-action="Edit" asp-route-id="@item.Id">Редакция</a>
                                <button type="button" class="btn btn-sm btn-danger delete-btn" data-id="@item.Id" data-confirm="Сигурни ли сте, че искате да сторнирате куриерската пратка?">Сторно</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == filter.Page ? "active" : string.Empty)">
                    <a class="page-link"
                       asp-action="AllCouriers"
                       asp-route-Page="@pageNumber"
                       asp-route-DocumentNumber="@filter.DocumentNumber"
                       asp-route-ShippmentBill="@filter.ShippmentBill"
                       asp-route-ProductSKU="@filter.ProductSKU"
                       asp-route-Size="@filter.Size"
                       asp-route-CourierName="@filter.CourierName"
                       asp-route-DateFrom="@filter.DateFrom?.ToString("yyyy-MM-dd")"
                       asp-route-DateTo="@filter.DateTo?.ToString("yyyy-MM-dd")"
                       asp-route-PaymentMethod="@filter.PaymentMethod"
                       asp-route-Operator="@filter.Operator"
                       asp-route-Status="@filter.Status">@pageNumber</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script>
        $(document).on('click', '.delete-btn', function () {
            if (!confirm($(this).data('confirm'))) {
                return;
            }

            $.ajax({
                type: 'POST',
                url: '/Courier/CreditCourier',
                data: { id: $(this).data('id') },
                success: function (response) {
                    if (response.response) {
                        window.location.reload();
                    } else {
                        alert(response.message || 'Сторното не беше записано.');
                    }
                }
            });
        });
    </script>
}
