@model List<ProductProductionProfile>

@{
    ViewData["Title"] = "Производствени изделия";
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">Нов производствен профил</a>
</div>

@if (!Model.Any())
{
    <p>Няма създадени производствени профили.</p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Артикул</th>
                <th>Производствено име</th>
                <th>Мерна единица</th>
                <th>Стандартно количество</th>
                <th>Активен</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var profile in Model)
            {
                <tr>
                    <td>@profile.Product.SKU - @profile.Product.Description</td>
                    <td>@profile.ProductionName</td>
                    <td>@profile.ProductionUnitOfMeasure.Name</td>
                    <td>@profile.StandardProductionQuantity.ToString("N4")</td>
                    <td>@(profile.IsActive ? "Да" : "Не")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@profile.Id">Редакция</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
