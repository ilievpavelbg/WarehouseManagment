@using System.ComponentModel
@using WarehouseManagment.Data

@{
    ViewData["Title"] = "POS продажба";
}

<h1 class="text-center">@ViewData["Title"]</h1>

<div class="row g-3 mb-4">
    <div class="col-md-5">
        <label class="form-label">Баркод</label>
        <form id="barcodeForm" class="d-flex" method="get">
            <input type="text" id="barcode" class="form-control me-2" placeholder="Сканирай или въведи баркод" autocomplete="off" autofocus>
            <button type="submit" class="btn btn-outline-success">Търси</button>
        </form>
    </div>
    <div class="col-md-7">
        <label class="form-label">Ръчен избор</label>
        <div class="input-group">
            <select id="manualProduct" class="form-select">
                <option value="">Избери артикул</option>
            </select>
            <select id="manualVariant" class="form-select">
                <option value="">Размер / вариант</option>
            </select>
            <button type="button" id="manualLoad" class="btn btn-outline-primary">Зареди</button>
        </div>
    </div>
</div>

<div class="product-container col-md-8"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadProducts();

            $('#barcodeForm').on('submit', function (event) {
                event.preventDefault();
                loadByBarcode($('#barcode').val());
            });

            $('#barcode').on('change', function () {
                loadByBarcode($(this).val());
            });

            $('#manualProduct').on('change', function () {
                var productId = $(this).val();
                $('#manualVariant').empty().append($('<option>').val('').text('Размер / вариант'));

                if (!productId) {
                    return;
                }

                $.get('/Sale/Variants', { productId: productId }, function (variants) {
                    $.each(variants, function (_, item) {
                        $('#manualVariant').append($('<option>').val(item.id).text(item.text + ' / наличност ' + item.quantity + ' бр'));
                    });
                });
            });

            $('#manualLoad').on('click', function () {
                var variantId = $('#manualVariant').val();

                if (!variantId) {
                    alert('Изберете размер / вариант.');
                    return;
                }

                loadByBarcode(variantId);
            });

            function loadProducts() {
                $.get('/Sale/Products', function (products) {
                    $.each(products, function (_, item) {
                        $('#manualProduct').append($('<option>').val(item.id).text(item.text));
                    });
                });
            }

            function loadByBarcode(value) {
                if (!value) {
                    return;
                }

                $.ajax({
                    url: '/Sale/Index',
                    type: 'GET',
                    data: { barcode: value },
                    success: function (productData) {
                        $('.product-container').empty();
                        createProductRow(productData.productData);
                        $('#barcode').val('').focus();
                    },
                    error: function () {
                        alert('Артикулът не е намерен.');
                    }
                });
            }

            function createProductRow(productData) {
                var row = $('<div class="card p-3">');
                row.append($('<h4>').text(productData.productSKU + ' / ' + productData.description + ' / ' + productData.size));
                row.append($('<div class="mb-2">').text('Наличност: ' + productData.availability + ' бр'));

                var unitPriceInput = $('<input type="number" class="product-unit-price form-control" disabled>').val(productData.unitPrice);
                row.append(inputGroup('Единична цена', unitPriceInput));

                row.append(createPaymentMethodDropdown(productData.paymentMethod));

                var quantityInput = $('<input type="number" min="1" class="product-quantity form-control">')
                    .val(1)
                    .attr('max', productData.availability);
                row.append(inputGroup('Количество', quantityInput));

                row.append(createDiscountDropdown(productData.discount));

                var totalPriceInput = $('<input class="product-total-price form-control" id="TotalPrice" disabled>').val(productData.unitPrice);
                row.append(inputGroup('Общо', totalPriceInput));

                var notesInput = $('<input type="text" class="notes-input form-control">');
                row.append(inputGroup('Коментар', notesInput));

                var saleButton = $('<button class="btn btn-outline-success fs-5">Запиши POS продажба</button>');
                row.append($('<div class="text-center">').append(saleButton));

                quantityInput.on('input', updateTotal);
                row.find('.product-discount').on('change', updateTotal);
                updateTotal();

                saleButton.on('click', function () {
                    var quantity = parseInt(quantityInput.val());

                    if (quantity <= 0) {
                        alert('Количеството трябва да е по-голямо от нула.');
                        return;
                    }

                    if (quantity > productData.availability) {
                        alert('Количеството, което сте избрали, е по-голямо от наличността.');
                        return;
                    }

                    var sale = {
                        productSKU: productData.productSKU,
                        discount: parseInt(row.find('.product-discount').val()),
                        quantity: quantity,
                        productId: productData.productId,
                        productInventoryId: productData.productInventoryId,
                        paymentMethod: parseInt(row.find('.product-paymentMethod').val()),
                        notes: notesInput.val()
                    };

                    $.ajax({
                        url: '/Sale/Create',
                        type: 'POST',
                        data: sale,
                        success: function (response) {
                            if (response.success) {
                                alert('Продажбата е записана успешно.');
                                window.location.reload();
                            } else {
                                alert(response.message || 'Продажбата не беше записана.');
                            }
                        }
                    });
                });

                $('.product-container').append(row);

                function updateTotal() {
                    var unitPrice = parseFloat(unitPriceInput.val()) || 0;
                    var quantity = parseInt(quantityInput.val()) || 0;
                    var discount = parseFloat(row.find('.product-discount').val()) || 0;
                    var totalPrice = unitPrice * quantity * (1 - discount / 100);
                    totalPriceInput.val(totalPrice.toFixed(2));
                }
            }

            function inputGroup(label, input) {
                var group = $('<div class="input-group input-group-lg mb-2">');
                group.append($('<span class="input-group-text fw-bold">').text(label + ':'));
                group.append(input);
                return group;
            }

            function createDiscountDropdown(selectedDiscount) {
                var dropdown = $('<select class="product-discount form-select">');
                var values = [
                    @foreach (var value in Enum.GetValues(typeof(Discount)).Cast<Discount>())
                    {
                        <text>{ value: "@((int)value)", text: "@((int)value)%" },</text>
                    }
                ];

                $.each(values, function (_, item) {
                    dropdown.append($('<option>').val(item.value).text(item.text).prop('selected', item.value == selectedDiscount));
                });

                return inputGroup('Отстъпка', dropdown);
            }

            function createPaymentMethodDropdown(selectedPaymentMethod) {
                var dropdown = $('<select class="product-paymentMethod form-select">');
                var values = [
                    @foreach (var value in Enum.GetValues(typeof(PaymentMethod)).Cast<PaymentMethod>())
                    {
                        var enumMember = typeof(PaymentMethod).GetMember(value.ToString())[0];
                        var descriptionAttribute = enumMember.GetCustomAttributes(typeof(DescriptionAttribute), false).FirstOrDefault() as DescriptionAttribute;
                        var description = descriptionAttribute != null ? descriptionAttribute.Description : value.ToString();
                        <text>{ value: "@((int)value)", text: "@Html.Raw(description.Replace("\"", "&quot;"))" },</text>
                    }
                ];

                $.each(values, function (_, item) {
                    dropdown.append($('<option>').val(item.value).text(item.text).prop('selected', item.value == selectedPaymentMethod));
                });

                return inputGroup('Начин на плащане', dropdown);
            }
        });
    </script>
}
