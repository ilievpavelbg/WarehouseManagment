@model List<BillOfMaterials>

@{
    ViewData["Title"] = "Разходни норми";
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">Нова чернова разходна норма</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Артикул</th>
            <th>Версия</th>
            <th>В сила от</th>
            <th>Статус</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bom in Model)
        {
            <tr>
                <td>@bom.Product.SKU - @bom.Product.Description</td>
                <td>@bom.Version</td>
                <td>@bom.EffectiveFrom.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (bom.IsActive)
                    {
                        <span class="badge bg-success">Активна</span>
                    }
                    else if (bom.HasBeenActivated)
                    {
                        <span class="badge bg-secondary">История</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Чернова</span>
                    }
                </td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@bom.Id">Отвори</a>
                    @if (!bom.IsActive && !bom.HasBeenActivated)
                    {
                        <form asp-action="Activate" asp-route-id="@bom.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Активирай</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
