@model List<ProductCostCalculation>

@{
    ViewData["Title"] = "Калкулации";
}

<h1 class="text-center">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="mb-3">
    <a class="btn btn-primary" asp-action="Create">Нова чернова калкулация</a>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Артикул</th>
            <th>Версия</th>
            <th>Дата</th>
            <th>Статус</th>
            <th>Обща себестойност</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var calculation in Model)
        {
            <tr>
                <td>@calculation.Product.SKU - @calculation.Product.Description</td>
                <td>@calculation.Version</td>
                <td>@calculation.EffectiveDate.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (calculation.IsActive)
                    {
                        <span class="badge bg-success">Активна</span>
                    }
                    else if (calculation.HasBeenActivated)
                    {
                        <span class="badge bg-secondary">История</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Чернова</span>
                    }
                </td>
                <td>@calculation.TotalCost.ToString("N4") @calculation.Currency</td>
                <td class="text-nowrap">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@calculation.Id">Отвори</a>
                    @if (!calculation.IsActive && !calculation.HasBeenActivated)
                    {
                        <form asp-action="Activate" asp-route-id="@calculation.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Активирай</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
